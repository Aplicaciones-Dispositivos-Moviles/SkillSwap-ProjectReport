@startuml ReputationComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(reputationBC, "Reputation Bounded Context") {
    Component(verifierReliabilityController, "VerifierReliability Controller", "Java Class", "RESTful API Controller")
    Component(studentEmployabilityController, "StudentEmployability Controller", "Java Class", "RESTful API Controller")
    Component(reputationCommandService, "Reputation CommandService", "Java Class", "Lógica de negocio: recálculo por eventos")
    Component(reputationQueryService, "Reputation QueryService", "Java Class", "Consultas")
    Component(assessmentEventHandlers, "Assessment EventHandlers", "Java Class", "Reacciona a AssessmentAttemptPassed y VerificationCaseResolved")
    Component(verifierReliabilityRepository, "VerifierReliability Repository", "Java Interface", "Interface persistencia")
    Component(studentEmployabilityRepository, "StudentEmployabilityScore Repository", "Java Interface", "Interface persistencia")
    Component(verifierProfileNotifierExternal, "VerifierProfile NotifierAdapter", "Java Class", "Sincronización con Assessment & Peer Review")
    Component(reputationContextFacade, "Reputation ContextFacade", "Java Class", "Punto de entrada interno")
}

Component_Ext(verifierProfileContextFacade, "VerifierProfile ContextFacade", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(assessmentDomainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Bounded Context: Assessment & Peer Review")
Component_Ext(moderationCommandService, "Moderation CommandService", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(androidApp, verifierReliabilityController, "Request HTTP a Reputation")
Rel(flutterApp, verifierReliabilityController, "Request HTTP a Reputation")
Rel(androidApp, studentEmployabilityController, "Request HTTP a Reputation")
Rel(flutterApp, studentEmployabilityController, "Request HTTP a Reputation")

Rel(verifierReliabilityController, reputationQueryService, "Usa")
Rel(studentEmployabilityController, reputationQueryService, "Usa")

Rel(reputationCommandService, verifierReliabilityRepository, "Usa")
Rel(reputationCommandService, studentEmployabilityRepository, "Usa")
Rel(reputationQueryService, verifierReliabilityRepository, "Usa")
Rel(reputationQueryService, studentEmployabilityRepository, "Usa")
Rel(verifierReliabilityRepository, mainDB, "SQL Transaction")
Rel(studentEmployabilityRepository, mainDB, "SQL Transaction")

Rel(assessmentDomainEventPublisher, assessmentEventHandlers, "En proceso, tras el commit")
Rel(assessmentEventHandlers, reputationCommandService, "Invoca recálculo de confiabilidad / empleabilidad")

Rel(reputationCommandService, verifierProfileNotifierExternal, "Delega sincronización")
Rel(verifierProfileNotifierExternal, verifierProfileContextFacade, "UpdateRating(score)")

Rel(reputationContextFacade, reputationCommandService, "Delega")
Rel(reputationContextFacade, reputationQueryService, "Delega")

Rel(moderationCommandService, reputationContextFacade, "Notificar reversión de decisión / sanción aplicada")

@enduml