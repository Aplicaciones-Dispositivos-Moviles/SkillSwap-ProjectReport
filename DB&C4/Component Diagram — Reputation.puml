@startuml ReputationComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(apiGateway, "Api Gateway", "ASP.NET Core (C#)")
ContainerDb_Ext(mainDB, "SkillSwap Database", "MySQL 8")

Container_Boundary(reputationBC, "Reputation Bounded Context") {
    Component(verifierReliabilityController, "VerifierReliability Controller", "C# Class", "RESTful API Controller")
    Component(studentEmployabilityController, "StudentEmployability Controller", "C# Class", "RESTful API Controller")
    Component(reputationCommandService, "Reputation CommandService", "C# Class", "Lógica de negocio: recálculo por eventos")
    Component(reputationQueryService, "Reputation QueryService", "C# Class", "Consultas")
    Component(verifierReliabilityRepository, "VerifierReliability Repository", "C# Interface", "Interface persistencia")
    Component(studentEmployabilityRepository, "StudentEmployabilityScore Repository", "C# Interface", "Interface persistencia")
    Component(verifierProfileNotifierExternal, "VerifierProfile NotifierAdapter", "C# Class", "Sincronización con Assessment & Peer Review")
    Component(reputationContextFacade, "Reputation ContextFacade", "C# Class", "Punto de entrada interno")
}

Component_Ext(assessmentContextFacade, "Assessment ContextFacade", "C# Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(assessmentCommandService, "Assessment CommandService", "C# Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(moderationCommandService, "Moderation CommandService", "C# Class", "Bounded Context: Moderation & Disputes")

Rel(apiGateway, verifierReliabilityController, "Request HTTP a Reputation")
Rel(apiGateway, studentEmployabilityController, "Request HTTP a Reputation")
Rel(verifierReliabilityController, reputationQueryService, "Usa")
Rel(studentEmployabilityController, reputationQueryService, "Usa")

Rel(reputationCommandService, verifierReliabilityRepository, "Usa")
Rel(reputationCommandService, studentEmployabilityRepository, "Usa")
Rel(reputationQueryService, verifierReliabilityRepository, "Usa")
Rel(reputationQueryService, studentEmployabilityRepository, "Usa")
Rel(verifierReliabilityRepository, mainDB, "SQL Transaction")
Rel(studentEmployabilityRepository, mainDB, "SQL Transaction")

Rel(reputationCommandService, verifierProfileNotifierExternal, "Delega sincronización")
Rel(verifierProfileNotifierExternal, assessmentContextFacade, "Actualizar VerifierProfile.rating / reviewCount")

Rel(reputationContextFacade, reputationCommandService, "Delega")
Rel(reputationContextFacade, reputationQueryService, "Delega")

Rel(assessmentCommandService, reputationContextFacade, "Notificar resolución de caso / aprobación automática")
Rel(moderationCommandService, reputationContextFacade, "Notificar reversión de decisión / sanción aplicada")

@enduml