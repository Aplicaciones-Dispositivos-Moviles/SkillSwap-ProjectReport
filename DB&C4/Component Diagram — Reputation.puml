@startuml ReputationComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(reputationBC, "Reputation Bounded Context") {
    Component(reliabilityController, "VerifierReliabilitiesController", "Java Class", "Confiabilidad y rango del Verificador")
    Component(employabilityController, "StudentEmployabilityScoresController", "Java Class", "Employability Score del estudiante")
    Component(eventHandlers, "Assessment EventHandlers", "Java Class", "RecordCaseResolution, RecordMissedDeadline y RecordAutomaticApproval")
    Component(reputationCommandService, "ReputationCommandService", "Java Class", "Recalcula confiabilidad y empleabilidad por eventos")
    Component(queryServices, "VerifierReliability / StudentEmployability QueryServices", "Java Class", "Consultas")
    Component(calculators, "VerifierReliabilityCalculator / EmployabilityScoreCalculator", "Domain Service", "Fórmulas de confiabilidad (0–100) y empleabilidad")
    Component(seniorPolicy, "SeniorVerifierPolicy", "Domain Service", "Senior = rango Oro (≥ 100 casos resueltos) y confiabilidad ≥ 90")
    Component(repositories, "VerifierReliability / StudentEmployabilityScore Repositories", "Java Interface", "Interfaces de persistencia")
    Component(reputationFacade, "ReputationContextFacade", "Java Class", "isSeniorVerifier / findSeniorVerifiers")
}

Component_Ext(assessmentPublisher, "DomainEventPublisher", "Java Class (Shared)", "Bounded Context: Assessment & Peer Review")
Component_Ext(verifierFacade, "VerifierProfileContextFacade", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(deadlinePolicyService, "ReviewDeadlinePolicyCommandService", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(disputeCommandService, "DisputeCommandService", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(mobileApps, reliabilityController, "Request HTTP", "HTTPS/JSON")
Rel(mobileApps, employabilityController, "Request HTTP", "HTTPS/JSON")
Rel(reliabilityController, queryServices, "Usa")
Rel(employabilityController, queryServices, "Usa")

Rel(assessmentPublisher, eventHandlers, "VerificationCaseResolved, VerificationCaseDeadlineMissed, AssessmentAttemptPassed (tras el commit)")
Rel(eventHandlers, reputationCommandService, "Registra la resolución, el plazo incumplido o la aprobación automática")
Rel(reputationCommandService, calculators, "Recalcula")
Rel(reputationCommandService, repositories, "Usa")
Rel(queryServices, repositories, "Usa")
Rel(repositories, mainDB, "SQL Transaction")
Rel_U(reputationCommandService, verifierFacade, "Sincronizar el rating (updateRating)")

Rel(reputationFacade, repositories, "Usa")
Rel(reputationFacade, seniorPolicy, "Evalúa")
Rel(deadlinePolicyService, reputationFacade, "¿Es Verificador senior?")
Rel(disputeCommandService, reputationFacade, "Filtrar Verificadores senior disponibles")

@enduml
