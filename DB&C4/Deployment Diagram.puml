@startuml SkillSwapDeployment
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

Deployment_Node(userDevice, "Dispositivo Móvil del Usuario", "Android"){
    Container(androidApp, "Android Native App", "Kotlin / Jetpack Compose", "Cliente móvil nativo usado por Estudiantes y Verificadores.")
    Container(flutterApp, "Cross-Platform App", "Flutter / Dart (Android)", "Cliente móvil multiplataforma dirigido a Android.")
    Container(mlKitSdk, "ML Kit SDK", "Firebase On-Device", "Lee los datos del certificado en el dispositivo; la app los envía al backend en el multipart.")
}

Deployment_Node(staticHosting, "Hosting Estático", "GitHub Pages"){
    Container(landingPage, "Landing Page", "HTML5 / CSS3 / JavaScript", "Sitio web estático que presenta el modelo de negocio de SkillSwap.")
}

Deployment_Node(cloudPlatform, "Render", "Plataforma Cloud"){
    Deployment_Node(backendRuntime, "Web Service", "Docker Container (JRE 21)"){
        Container(api, "SkillSwap API", "Java 21 / Spring Boot", "API RESTful que aloja los ocho Bounded Contexts y publica la documentación OpenAPI.")
    }
    Deployment_Node(dbServer, "Render PostgreSQL", "Base de datos administrada"){
        ContainerDb(mainDB, "SkillSwap Database", "PostgreSQL 16", "Instancia única compartida por los Bounded Contexts; migraciones Flyway.")
    }
}

Deployment_Node(externalCloud, "Servicios Externos en la Nube", "SaaS"){
    System_Ext(cloudStorage, "Cloudinary", "Archivos de certificados")
    System_Ext(emailService, "Brevo (Email API)", "Correo de verificación")
    System_Ext(pushService, "Firebase Cloud Messaging", "Entrega las notificaciones push al dispositivo")
    System_Ext(geminiApi, "Gemini API", "Interpretación de la meta y generación de preguntas")
    System_Ext(playBilling, "Google Play Billing (vía RevenueCat)", "Suscripción mensual")
}

Rel(androidApp, mlKitSdk, "Invoca localmente", "SDK call")
Rel(flutterApp, mlKitSdk, "Invoca localmente", "SDK call")

Rel(androidApp, api, "Consume la API RESTful", "HTTPS")
Rel(flutterApp, api, "Consume la API RESTful", "HTTPS")

Rel(api, mainDB, "Lee/Escribe", "JDBC")

Rel(api, cloudStorage, "Guarda certificados", "HTTPS")
Rel(api, emailService, "Envía correos", "HTTPS")
Rel(api, pushService, "Envía notificaciones push", "HTTPS")
Rel(api, geminiApi, "Interpreta la meta y genera preguntas", "HTTPS")
Rel(api, playBilling, "Verifica la compra y cancela la renovación", "HTTPS")
Rel(playBilling, api, "Notifica cambios de la suscripción (webhook)", "HTTPS")
Rel(androidApp, playBilling, "Compra el plan mensual (SDK de RevenueCat)", "HTTPS")
Rel(flutterApp, playBilling, "Compra el plan mensual (SDK de RevenueCat)", "HTTPS")

@enduml
