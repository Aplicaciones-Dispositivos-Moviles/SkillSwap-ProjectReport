@startuml SkillSwapContainer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(student, "Estudiante", "Sube certificados, sigue su ruta de aprendizaje y demuestra sus habilidades.")
Person(verifier, "Verificador", "Revisa los casos que la IA no puede resolver con suficiente confianza; el Verificador senior resuelve las apelaciones y los certificados sospechosos.")

System_Boundary(skillSwapSystem, "SkillSwap Platform") {
    Container(landingPage, "Landing Page (estática)", "HTML5 / CSS3 / JavaScript", "Sitio web estático que presenta el modelo de negocio de SkillSwap. Informativa; no consume la API.")
    Container(androidApp, "Android Native Application", "Kotlin / Jetpack Compose", "Aplicación móvil nativa para Estudiantes y Verificadores.")
    Container(flutterApp, "Cross-Platform Application", "Flutter / Dart (dirigido a Android)", "Aplicación móvil multiplataforma para Estudiantes y Verificadores.")
    Container(apiGateway, "Api / RESTful Web Services", "Java 21 / Spring Boot", "Expone los endpoints del dominio, aplica las reglas de negocio y orquesta la lógica de los ocho Bounded Contexts.")
    ContainerDb(mainDB, "SkillSwap Database", "PostgreSQL 16", "Base de datos única compartida por los ocho Bounded Contexts (skillswap_db)")
}

System_Ext(emailService, "Brevo (Email API)", "Envío transaccional del correo de verificación de la cuenta institucional")
System_Ext(fcm, "Firebase Cloud Messaging", "Entrega de notificaciones push a las apps móviles")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR/Entity Extraction")
System_Ext(cloudStorage, "Cloudinary", "Cloud Storage para las imágenes de certificados")
System_Ext(googlePlayBilling, "Google Play Billing (vía RevenueCat)", "Cobro de la suscripción mensual; RevenueCat valida la compra y notifica sus cambios")
System_Ext(geminiApi, "Gemini API", "IA generativa: interpreta la meta seleccionando habilidades solo del catálogo interno y genera las preguntas de los quizzes")

Rel(student, androidApp, "Usa")
Rel(verifier, androidApp, "Usa")
Rel(student, flutterApp, "Usa")
Rel(verifier, flutterApp, "Usa")

Rel(student, landingPage, "Visita")
Rel(verifier, landingPage, "Visita")

Rel(androidApp, apiGateway, "Consume API RESTful vía HTTPS")
Rel(flutterApp, apiGateway, "Consume API RESTful vía HTTPS")
Rel(androidApp, mlKitService, "Extrae datos del certificado (OCR on-device)")
Rel(flutterApp, mlKitService, "Extrae datos del certificado (OCR on-device)")
Rel(androidApp, googlePlayBilling, "Compra el plan mensual (SDK de RevenueCat)")
Rel(flutterApp, googlePlayBilling, "Compra el plan mensual (SDK de RevenueCat)")

Rel(apiGateway, mainDB, "Lee/Escribe")

Rel(apiGateway, emailService, "Envía el correo de verificación", "HTTPS")
Rel(apiGateway, fcm, "Envía notificaciones push al device token", "HTTPS")
Rel(fcm, androidApp, "Entrega la notificación push")
Rel(fcm, flutterApp, "Entrega la notificación push")
Rel(apiGateway, cloudStorage, "Guarda las imágenes de los certificados")
BiRel(apiGateway, googlePlayBilling, "Verifica la compra y cancela la renovación; recibe sus cambios por webhook")
Rel(apiGateway, geminiApi, "Interpreta la meta y genera preguntas")

@enduml