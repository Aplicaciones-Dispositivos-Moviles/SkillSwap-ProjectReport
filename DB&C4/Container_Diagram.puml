@startuml SkillSwapContainer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(student, "Estudiante", "Sube certificados, sigue su ruta de aprendizaje y demuestra sus habilidades.")
Person(verifier, "Verificador", "Revisa los casos que la IA no puede resolver con suficiente confianza.")
Person(professor, "Profesor Universitario / Coordinador", "Supervisa la calidad del proceso de verificación.")

System_Boundary(skillSwapSystem, "SkillSwap Platform") {
    Container(landingPage, "Landing Page", "HTML5 / CSS3 / JavaScript", "Sitio web estático que presenta el modelo de negocio de SkillSwap.")
    Container(androidApp, "Android Native Application", "Kotlin / Jetpack Compose", "Aplicación móvil nativa para Estudiantes, Verificadores y Profesor.")
    Container(flutterApp, "Cross-Platform Application", "Flutter / Dart (dirigido a Android)", "Aplicación móvil multiplataforma para Estudiantes, Verificadores y Profesor.")
    Container(apiGateway, "Api Gateway", "ASP.NET Core (C#)", "Controlador de tráfico de solicitudes HTTP entrantes.")

    Container(identityBC, "Identity & Access Bounded Context", "C# / ASP.NET Core", "Gestión de autenticación y perfiles")
    Container(credentialBC, "Credential Verification Bounded Context", "C# / ASP.NET Core", "Extracción OCR y validación de legitimidad de certificados")
    Container(pathEngineBC, "Learning Path Engine Bounded Context", "C# / ASP.NET Core", "Detección de brechas de habilidad y generación de ruta personalizada")
    Container(assessmentBC, "Assessment & Peer Review Bounded Context", "C# / ASP.NET Core", "Intentos de evaluación, asignación y revisión de Verificador")
    Container(reputationBC, "Reputation Bounded Context", "C# / ASP.NET Core", "Confiabilidad del Verificador y Employability Score")
    Container(walletBC, "Wallet & Incentives Bounded Context", "C# / ASP.NET Core", "Balance y transferencias de SkillCredits")
    Container(moderationBC, "Moderation & Disputes Bounded Context", "C# / ASP.NET Core", "Resolución de disputas y sanciones")

    ContainerDb(mainDB, "SkillSwap Database", "MySQL 8", "Base de datos única compartida por los siete Bounded Contexts (skillswap_db)")
}

System_Ext(emailService, "Email Api", "Integración con correos institucionales")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR/Entity Extraction")
System_Ext(cloudStorage, "Cloudinary", "Cloud Storage para certificados y evidencias")

Rel(student, androidApp, "Usa")
Rel(verifier, androidApp, "Usa")
Rel(professor, androidApp, "Usa")
Rel(student, flutterApp, "Usa")
Rel(verifier, flutterApp, "Usa")
Rel(professor, flutterApp, "Usa")

Rel(student, landingPage, "Visita")
Rel(verifier, landingPage, "Visita")
Rel(professor, landingPage, "Visita")

Rel(androidApp, apiGateway, "Consume API RESTful vía HTTPS")
Rel(flutterApp, apiGateway, "Consume API RESTful vía HTTPS")

Rel(apiGateway, identityBC, "Enruta solicitudes")
Rel(apiGateway, credentialBC, "Enruta solicitudes")
Rel(apiGateway, pathEngineBC, "Enruta solicitudes")
Rel(apiGateway, assessmentBC, "Enruta solicitudes")
Rel(apiGateway, reputationBC, "Enruta solicitudes")
Rel(apiGateway, walletBC, "Enruta solicitudes")
Rel(apiGateway, moderationBC, "Enruta solicitudes")

Rel(identityBC, mainDB, "Lee/Escribe")
Rel(credentialBC, mainDB, "Lee/Escribe")
Rel(pathEngineBC, mainDB, "Lee/Escribe")
Rel(assessmentBC, mainDB, "Lee/Escribe")
Rel(reputationBC, mainDB, "Lee/Escribe")
Rel(walletBC, mainDB, "Lee/Escribe")
Rel(moderationBC, mainDB, "Lee/Escribe")

Rel(identityBC, emailService, "Envía correo de validación")
Rel(credentialBC, mlKitService, "Extrae datos del certificado (OCR on-device)")
Rel(credentialBC, cloudStorage, "Guarda la imagen del certificado")
Rel(assessmentBC, cloudStorage, "Guarda evidencias adjuntas a un caso de verificación")
Rel(moderationBC, emailService, "Envía notificación de sanción o resolución de disputa")

@enduml