@startuml db-credential-verification
!pragma layout smetana
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam linetype ortho
skinparam ArrowColor #546E7A
skinparam class {
  BorderColor #2F5F8A
  AttributeFontColor #1F2933
  AttributeFontSize 11
}
skinparam package {
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
  FontSize 10
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 10
}
hide circle
hide stereotype

title <size:14>Base de datos · Credential Verification</size>
package "Credential Verification" {
entity "<color:#FFFFFF><b>certificates</b></color>" as certificates #back:FFFFFF;header:2F5F8A;line:2F5F8A {
  * id : integer <<PK>>
  --
  * owner_id : integer <<ref>>
    holder_name : varchar(255)
    institution_name : varchar(255)
    course_name : varchar(255)
    issue_date : date
    duration_hours : integer
    certificate_number : varchar(255)
    verification_code : varchar(255)
    verification_url : varchar(2048)
    qr_payload : varchar(4096)
  * ocr_text : text
  * file_hash : varchar(64)
  * storage_reference : varchar(512)
  * status : varchar(20)
  * verification_method : varchar(20)
    risk_score : integer
  * created_at : timestamptz
    verified_at : timestamptz
  * holder_name_mismatch : boolean
}
}
entity "<b>users</b>\n<size:9>(Identity & Access)</size>" as users <<ref>> #back:F5F5F5;header:DADADA;line:9E9E9E {
  * id : integer <<PK>>
}
users ||..o{ certificates : "owner_id"
legend bottom left
  <b>Notación</b>: <b>●</b> NOT NULL · <b><<PK>></b> clave primaria · <b><<FK>></b> FOREIGN KEY física ·
  <b><<ref>></b> referencia por id sin FOREIGN KEY (otro agregado o Bounded Context) · <b><<UK>></b> único (<b>UK*</b> índice único parcial)
  Línea continua: FOREIGN KEY física · Línea discontinua: referencia lógica por id · Tablas grises: tablas de otro Bounded Context
  Esquema final de las migraciones Flyway V1–V10 (PostgreSQL). varchar = character varying · timestamptz = timestamp with time zone
  <b>Restricciones e índices</b>
  • UNIQUE (owner_id, file_hash)
  • INDEX (file_hash), (certificate_number), (verification_code)
  • Los campos OCR llegan desde el cliente móvil (ML Kit on-device)
endlegend

@enduml
