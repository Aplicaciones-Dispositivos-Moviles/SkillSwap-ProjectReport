@startuml SubscriptionBillingComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(revenueCat, "Google Play Billing (vía RevenueCat)", "Cobro de la suscripción mensual; RevenueCat valida la compra y notifica sus cambios")

Container_Boundary(subscriptionBC, "Subscription & Billing Bounded Context") {
    Component(subscriptionsController, "SubscriptionsController", "Java Class", "RESTful API Controller: plan vigente, suscribirse y cancelar")
    Component(webhookController, "RevenueCatWebhookController", "Java Class", "Recibe el webhook de RevenueCat (encabezado Authorization)")
    Component(subscriptionCommandService, "SubscriptionCommandService", "Java Class", "Lógica de negocio: crear, cancelar, vencer y procesar eventos")
    Component(subscriptionQueryService, "SubscriptionQueryService", "Java Class", "Suscripción vigente y límites del plan")
    Component(expirationScheduler, "SubscriptionExpirationScheduler", "Java Class", "Vence periódicamente las suscripciones cuyo periodo pagado terminó")
    Component(paymentGateway, "PaymentGateway", "Java Interface", "Puerto: verifyPurchase y cancelRenewal")
    Component(revenueCatAdapter, "RevenueCatGatewayAdapter", "Java Class", "Adaptador de PaymentGateway hacia la API REST de RevenueCat")
    Component(simulatedAdapter, "SimulatedPaymentGatewayAdapter", "Java Class", "Adaptador en memoria para desarrollo y demostraciones")
    Component(subscriptionRepository, "SubscriptionRepository", "Java Interface", "Interface persistencia (subscriptions)")
    Component(webhookEventRepository, "ProcessedWebhookEventRepository", "Java Interface", "Interface persistencia (processed_webhook_events)")
    Component(subscriptionContextFacade, "SubscriptionContextFacade", "Java Class", "Punto de entrada interno: límites del plan vigente")
}

Component_Ext(learningPathCommandService, "LearningPath CommandService", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(enforcePlanLimitsHandler, "EnforcePlanLimitsEventHandler", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(assessmentCommandService, "AssessmentAttempt CommandService", "Java Class", "Bounded Context: Assessment & Peer Review")

Rel(androidApp, subscriptionsController, "Request HTTP a Subscription & Billing")
Rel(flutterApp, subscriptionsController, "Request HTTP a Subscription & Billing")
Rel(revenueCat, webhookController, "Notifica compras, renovaciones, cancelaciones y vencimientos", "Webhook HTTPS")

Rel(subscriptionsController, subscriptionCommandService, "Usa")
Rel(subscriptionsController, subscriptionQueryService, "Usa")
Rel(webhookController, subscriptionCommandService, "ProcessRevenueCatEventCommand")
Rel(expirationScheduler, subscriptionCommandService, "ExpireSubscriptionCommand")

Rel(subscriptionCommandService, paymentGateway, "Verifica la compra / cancela la renovación")
Rel(revenueCatAdapter, paymentGateway, "Implementa")
Rel(simulatedAdapter, paymentGateway, "Implementa")
Rel(revenueCatAdapter, revenueCat, "Consulta el entitlement / cancela la renovación", "HTTPS")

Rel(subscriptionCommandService, subscriptionRepository, "Usa")
Rel(subscriptionCommandService, webhookEventRepository, "Registra el event_id (idempotencia)")
Rel(subscriptionQueryService, subscriptionRepository, "Usa")
Rel(subscriptionRepository, mainDB, "SQL Transaction")
Rel(webhookEventRepository, mainDB, "SQL Transaction")

Rel(subscriptionContextFacade, subscriptionQueryService, "Delega")
Rel(learningPathCommandService, subscriptionContextFacade, "Pedir límites de rutas del plan")
Rel(assessmentCommandService, subscriptionContextFacade, "Pedir cupo de escalamientos y plazo de revisión")
Rel(subscriptionCommandService, enforcePlanLimitsHandler, "Publica SubscriptionExpired (pausa rutas adicionales)")

@enduml
