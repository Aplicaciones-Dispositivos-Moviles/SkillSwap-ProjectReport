@startuml SubscriptionBillingComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "MySQL 8")
System_Ext(stripeApi, "Stripe", "Procesamiento de pagos")

Container_Boundary(subscriptionBC, "Subscription & Billing Bounded Context") {
    Component(subscriptionController, "Subscription Controller", "C# Class", "RESTful API Controller")
    Component(subscriptionCommandService, "Subscription CommandService", "C# Class", "Lógica de negocio")
    Component(subscriptionQueryService, "Subscription QueryService", "C# Class", "Consultas")
    Component(subscriptionRepository, "Subscription Repository", "C# Interface", "Interface persistencia")
    Component(stripeGatewayExternal, "Stripe ExternalService", "C# Class", "Adaptador de cobro (PaymentGateway)")
    Component(webhookHandler, "Stripe WebhookHandler", "C# Class", "Recibe confirmaciones asíncronas de renovación")
    Component(subscriptionContextFacade, "Subscription ContextFacade", "C# Class", "Punto de entrada interno")
}

Rel(androidApp, subscriptionController, "Request HTTP a Subscription & Billing")
Rel(flutterApp, subscriptionController, "Request HTTP a Subscription & Billing")

Rel(subscriptionController, subscriptionCommandService, "Usa")
Rel(subscriptionController, subscriptionQueryService, "Usa")

Rel(subscriptionCommandService, subscriptionRepository, "Usa")
Rel(subscriptionQueryService, subscriptionRepository, "Usa")
Rel(subscriptionRepository, mainDB, "SQL Transaction")

Rel(subscriptionCommandService, stripeGatewayExternal, "Delega cobro (Payment Intent)")
Rel(stripeGatewayExternal, stripeApi, "Procesa el cobro")

Rel(stripeApi, webhookHandler, "Notifica confirmación de renovación", "Webhook")
Rel(webhookHandler, subscriptionCommandService, "Dispara renovación")

Rel(subscriptionContextFacade, subscriptionCommandService, "Delega")
Rel(subscriptionContextFacade, subscriptionQueryService, "Delega")

@enduml