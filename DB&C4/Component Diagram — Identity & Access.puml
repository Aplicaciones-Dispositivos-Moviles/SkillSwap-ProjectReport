@startuml IdentityComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(emailService, "Email Api")

Container_Boundary(identityBC, "Identity & Access Bounded Context") {
    Component(identityController, "Identity Controller", "Java Class", "RESTful API Controller")
    Component(identityCommandService, "Identity CommandService", "Java Class", "Lógica de negocio")
    Component(identityQueryService, "Identity QueryService", "Java Class", "Consultas")
    Component(identityRepository, "Identity Repository", "Java Interface", "Interface persistencia")
    Component(emailExternal, "Email ExternalService", "Java Class", "Integración correo")
    Component(identityContextFacade, "Identity ContextFacade", "Java Class", "Punto de entrada interno")
}

Component_Ext(walletContextFacade, "Wallet ContextFacade", "Java Class", "Bounded Context: Recognition & Incentives")
Component_Ext(moderationContextFacade, "Moderation ContextFacade", "Java Class", "Bounded Context: Moderation & Disputes")

Component_Ext(assessmentQueryService, "Assessment QueryService", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(reputationCommandService, "Reputation CommandService", "Java Class", "Bounded Context: Reputation")
Component_Ext(moderationQueryService, "Moderation QueryService", "Java Class", "Bounded Context: Moderation & Disputes")
Component_Ext(moderationCommandService, "Moderation CommandService", "Java Class", "Bounded Context: Moderation & Disputes")
Component_Ext(walletQueryService, "Wallet QueryService", "Java Class", "Bounded Context: Recognition & Incentives")

Rel(androidApp, identityController, "Request HTTP a Identity")
Rel(flutterApp, identityController, "Request HTTP a Identity")
Rel(identityController, identityCommandService, "Usa")
Rel(identityController, identityQueryService, "Usa")
Rel(identityCommandService, identityRepository, "Usa")
Rel(identityQueryService, identityRepository, "Usa")
Rel(identityRepository, mainDB, "SQL Transaction")

Rel(identityCommandService, emailExternal, "Delega envío")
Rel(emailExternal, emailService, "Enviar correo de validación")

Rel(identityCommandService, walletContextFacade, "Solicita la creación de la wallet inicial al registrarse")
Rel(identityQueryService, moderationContextFacade, "Pedir estado de sanción de la cuenta")

Rel(identityContextFacade, identityCommandService, "Delega")
Rel(identityContextFacade, identityQueryService, "Delega")

Rel(assessmentQueryService, identityContextFacade, "Pedir lista de Verificadores disponibles")
Rel(reputationCommandService, identityContextFacade, "Actualizar perfil con la nueva confiabilidad / Employability Score")
Rel(moderationQueryService, identityContextFacade, "Pedir datos de la cuenta reportada")
Rel(moderationCommandService, identityContextFacade, "Actualizar perfil en caso de sanción")
Rel(walletQueryService, identityContextFacade, "Confirmar biometría antes de canjear SkillCredits")

@enduml