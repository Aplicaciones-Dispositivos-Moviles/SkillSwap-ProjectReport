@startuml IdentityComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart", "La biometría se valida en el dispositivo")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(brevo, "Brevo (Email API)", "Correo transaccional")
System_Ext(fcm, "Firebase Cloud Messaging", "Notificaciones push")

Container_Boundary(identityBC, "Identity & Access Bounded Context") {
    Component(authController, "AuthenticationController", "Java Class", "sign-up, sign-in, verify-email y resend-verification")
    Component(usersController, "UsersController", "Java Class", "Perfil, intereses y token del dispositivo")
    Component(userCommandService, "UserCommandService", "Java Class", "Registro con correo institucional, inicio de sesión (emite el JWT) y perfil")
    Component(emailVerificationCommandService, "EmailVerificationCommandService", "Java Class", "Verifica el token y reenvía el correo")
    Component(emailVerificationIssuer, "EmailVerificationIssuer", "Java Class", "Genera el token (solo guarda su SHA-256) y publica EmailVerificationRequested")
    Component(userQueryService, "UserQueryService", "Java Class", "Consultas")
    Component(sendVerificationEmailHandler, "SendVerificationEmailEventHandler", "Java Class", "Arma y envía el correo de verificación")
    Component(emailSender, "EmailSender", "Java Interface", "Puerto de envío de correo")
    Component(brevoAdapter, "BrevoEmailSenderAdapter", "Java Class", "Adaptador HTTP de Brevo (sin API key: LoggingEmailSenderAdapter)")
    Component(pushSender, "PushNotificationSender", "Java Interface", "Puerto de notificaciones push")
    Component(firebaseAdapter, "FirebasePushNotificationAdapter", "Java Class", "Adaptador de FCM (sin credenciales: LoggingPushNotificationAdapter)")
    Component(userRepository, "UserRepository", "Java Interface", "Interface persistencia")
    Component(iamFacade, "IamContextFacade", "Java Class", "Nombre registrado del usuario")
    Component(notificationsFacade, "UserNotificationsContextFacade", "Java Class", "Envía un push al dispositivo del usuario")
}

Component_Ext(skillCatalogFacade, "SkillCatalogContextFacade", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(certificateCommandService, "CertificateCommandService", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(notifyCertificateHandler, "NotifyCertificateResolutionEventHandler", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(createWalletHandler, "CreateWalletEventHandler", "Java Class", "Bounded Context: Recognition & Incentives")

Rel(mobileApps, authController, "Request HTTP", "HTTPS/JSON")
Rel(mobileApps, usersController, "Request HTTP", "HTTPS/JSON")

Rel(authController, userCommandService, "Usa")
Rel(authController, emailVerificationCommandService, "Usa")
Rel(usersController, userCommandService, "Usa")
Rel(usersController, userQueryService, "Usa")

Rel(userCommandService, emailVerificationIssuer, "Emite la verificación al registrarse")
Rel(emailVerificationCommandService, emailVerificationIssuer, "Reenvía")
Rel(userCommandService, skillCatalogFacade, "Normaliza los intereses contra el catálogo")
Rel(userCommandService, userRepository, "Usa")
Rel(emailVerificationCommandService, userRepository, "Usa")
Rel(userQueryService, userRepository, "Usa")
Rel(userRepository, mainDB, "SQL Transaction")

Rel(emailVerificationIssuer, sendVerificationEmailHandler, "EmailVerificationRequested (tras el commit)")
Rel(sendVerificationEmailHandler, emailSender, "Envía")
Rel(brevoAdapter, emailSender, "Implementa")
Rel(brevoAdapter, brevo, "POST /v3/smtp/email", "HTTPS")

Rel(userCommandService, createWalletHandler, "UserRegistered (tras el commit)")

Rel(iamFacade, userRepository, "Usa")
Rel(notificationsFacade, userRepository, "Lee el token del dispositivo")
Rel(notificationsFacade, pushSender, "Envía")
Rel(firebaseAdapter, pushSender, "Implementa")
Rel(firebaseAdapter, fcm, "Envía el mensaje", "HTTPS")

Rel(certificateCommandService, iamFacade, "Pedir el nombre registrado (coincidencia con el titular)")
Rel(notifyCertificateHandler, notificationsFacade, "Notificar el resultado del certificado")

@enduml
