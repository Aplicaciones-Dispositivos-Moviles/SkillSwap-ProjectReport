@startuml IdentityComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(brevoApi, "Brevo (Email API)", "Envío transaccional del correo de verificación")
System_Ext(fcm, "Firebase Cloud Messaging", "Entrega de notificaciones push al dispositivo")

Container_Boundary(identityBC, "Identity & Access Bounded Context") {
    Component(authenticationController, "Authentication Controller", "Java Class", "sign-up, sign-in, verify-email (POST y GET), resend-verification")
    Component(usersController, "Users Controller", "Java Class", "me, bio, full-name, interests, device-token (PUT/DELETE)")
    Component(userCommandService, "User CommandService", "Java Class", "Registro, perfil, intereses y skillVector, device token")
    Component(emailVerificationCommandService, "EmailVerification CommandService", "Java Class", "Verifica el token (SHA-256) y reenvía el correo con cooldown")
    Component(userQueryService, "User QueryService", "Java Class", "Consultas")
    Component(sendVerificationEmailHandler, "SendVerificationEmail EventHandler", "Java Class", "Reacciona a EmailVerificationRequested")
    Component(emailSender, "EmailSender", "Java Interface", "Puerto de envío de correo")
    Component(brevoAdapter, "BrevoEmailSenderAdapter", "Java Class", "Adaptador HTTP a Brevo (LoggingEmailSenderAdapter si no hay API key)")
    Component(pushSender, "PushNotificationSender", "Java Interface", "Puerto de notificaciones push")
    Component(firebaseAdapter, "FirebasePushNotificationAdapter", "Java Class", "Adaptador Firebase Admin SDK (LoggingPushNotificationAdapter si no hay credenciales)")
    Component(userRepository, "User Repository", "Java Interface", "Interface persistencia")
    Component(iamContextFacade, "Iam ContextFacade", "Java Class", "Nombre completo registrado del usuario")
    Component(userNotificationsFacade, "UserNotifications ContextFacade", "Java Class", "Envía una push al device token del usuario")
}

Component_Ext(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica eventos en proceso tras el commit")
Component_Ext(skillCatalogFacade, "SkillCatalog ContextFacade", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(createWalletHandler, "CreateWallet EventHandler", "Java Class", "Bounded Context: Recognition & Incentives")
Component_Ext(certificateCommandService, "Certificate CommandService", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(notifyCertificateHandler, "NotifyCertificateResolution EventHandler", "Java Class", "Bounded Context: Credential Verification")

Rel(androidApp, authenticationController, "Request HTTP a Identity")
Rel(flutterApp, authenticationController, "Request HTTP a Identity")
Rel(androidApp, usersController, "Request HTTP a Identity")
Rel(flutterApp, usersController, "Request HTTP a Identity")

Rel(authenticationController, userCommandService, "Usa")
Rel(authenticationController, emailVerificationCommandService, "Usa")
Rel(usersController, userCommandService, "Usa")
Rel(usersController, userQueryService, "Usa")
Rel(userCommandService, userRepository, "Usa")
Rel(emailVerificationCommandService, userRepository, "Usa")
Rel(userQueryService, userRepository, "Usa")
Rel(userRepository, mainDB, "SQL Transaction")

Rel(userCommandService, domainEventPublisher, "Publica UserRegistered / EmailVerificationRequested")
Rel(emailVerificationCommandService, domainEventPublisher, "Publica EmailVerificationRequested (reenvío)")
Rel(domainEventPublisher, sendVerificationEmailHandler, "EmailVerificationRequested")
Rel(domainEventPublisher, createWalletHandler, "UserRegistered")
Rel(sendVerificationEmailHandler, emailSender, "Envía el correo con el enlace")
Rel(emailSender, brevoAdapter, "Implementado por")
Rel(brevoAdapter, brevoApi, "POST /v3/smtp/email", "HTTPS")

Rel(userCommandService, skillCatalogFacade, "Calcula el skillVector desde intereses y bio")

Rel(userNotificationsFacade, userRepository, "Lee el device token")
Rel(userNotificationsFacade, pushSender, "Envía la notificación")
Rel(pushSender, firebaseAdapter, "Implementado por")
Rel(firebaseAdapter, fcm, "Envía el mensaje", "HTTPS")
Rel(iamContextFacade, userRepository, "Lee el usuario")

Rel(certificateCommandService, iamContextFacade, "Pide el nombre completo registrado (holder name)")
Rel(notifyCertificateHandler, userNotificationsFacade, "Push con el resultado de la verificación")

@enduml
