@startuml AssessmentPeerReviewComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(assessmentBC, "Assessment & Peer Review Bounded Context") {
    Component(attemptsController, "AssessmentAttemptsController", "Java Class", "Enviar las respuestas del quiz")
    Component(casesController, "VerificationCasesController", "Java Class", "Casos del Verificador, evidencia, decisión y apelación")
    Component(profilesController, "VerifierProfiles / ReviewDeadlinePolicies Controllers", "Java Class", "Perfil y disponibilidad del Verificador; plazos definidos por el Verificador senior")
    Component(attemptCommandService, "AssessmentAttemptCommandService", "Java Class", "Califica (aprueba con 4 de 5); si reprueba abre un caso dentro del cupo mensual del plan")
    Component(caseCommandService, "VerificationCaseCommandService", "Java Class", "Aprobar o rechazar, apelar y reasignar casos vencidos")
    Component(profileCommandService, "VerifierProfile / ReviewDeadlinePolicy CommandServices", "Java Class", "Habilita al Verificador por nodo completado; define plazos")
    Component(queryServices, "QueryServices", "Java Class", "Intentos, casos, perfiles y plazos")
    Component(caseAssignment, "CaseAssignmentService + VerifierMatcher", "Java Class", "Asigna al Verificador disponible con menos carga habilitado en esa habilidad (nunca al propio estudiante)")
    Component(deadlineResolver, "ReviewDeadlineResolver", "Java Class", "Plazo del caso según el plan (48 h o 5 días hábiles) o la política vigente")
    Component(overdueScheduler, "OverdueCaseReassignmentScheduler", "Java Class", "Reasigna los casos con el plazo vencido")
    Component(repositories, "AssessmentAttempt / VerificationCase / VerifierProfile / ReviewDeadlinePolicy Repositories", "Java Interface", "Interfaces de persistencia")
    Component(verifierFacade, "VerifierProfileContextFacade", "Java Class", "Rating, Verificador habilitado y Verificadores disponibles")
    Component(eventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica tras el commit")
}

Component_Ext(learningPathFacade, "LearningPathContextFacade", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(subscriptionFacade, "SubscriptionContextFacade", "Java Class", "Bounded Context: Subscription & Billing")
Component_Ext(reputationFacade, "ReputationContextFacade", "Java Class", "Bounded Context: Reputation")
Component_Ext(reputationHandlers, "Reputation EventHandlers", "Java Class", "Bounded Context: Reputation")
Component_Ext(creditVerifierHandler, "CreditVerifierEventHandler", "Java Class", "Bounded Context: Recognition & Incentives")
Component_Ext(reputationCommandService, "ReputationCommandService", "Java Class", "Bounded Context: Reputation")
Component_Ext(disputeCommandService, "DisputeCommandService", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(mobileApps, attemptsController, "Request HTTP", "HTTPS/JSON")
Rel(mobileApps, casesController, "Request HTTP", "HTTPS/JSON")
Rel(mobileApps, profilesController, "Request HTTP", "HTTPS/JSON")
Rel(attemptsController, attemptCommandService, "Usa")
Rel(casesController, caseCommandService, "Usa")
Rel(profilesController, profileCommandService, "Usa")
Rel(attemptsController, queryServices, "Usa")
Rel(casesController, queryServices, "Usa")
Rel(profilesController, queryServices, "Usa")

Rel(attemptCommandService, caseAssignment, "Asigna el caso abierto")
Rel(caseCommandService, caseAssignment, "Reasigna")
Rel(attemptCommandService, deadlineResolver, "Calcula review_due_at")
Rel(overdueScheduler, caseCommandService, "ReassignOverdueCaseCommand")

Rel(attemptCommandService, repositories, "Usa")
Rel(caseCommandService, repositories, "Usa")
Rel(profileCommandService, repositories, "Usa")
Rel(queryServices, repositories, "Usa")
Rel(caseAssignment, repositories, "Usa")
Rel(repositories, mainDB, "SQL Transaction")

Rel_U(attemptCommandService, learningPathFacade, "Pedir el blueprint / completar el nodo aprobado")
Rel_U(caseCommandService, learningPathFacade, "Completar el nodo de un caso aprobado")
Rel_U(profileCommandService, learningPathFacade, "¿Completó la habilidad?")
Rel_U(attemptCommandService, subscriptionFacade, "Pedir PlanLimitsView (cupo de escalamientos)")
Rel_U(deadlineResolver, subscriptionFacade, "Pedir PlanLimitsView (plazo del plan)")
Rel_U(profileCommandService, reputationFacade, "¿Es Verificador senior?")

Rel(attemptCommandService, eventPublisher, "AssessmentAttemptPassed")
Rel(caseCommandService, eventPublisher, "VerificationCaseResolved / VerificationCaseDeadlineMissed")
Rel(eventPublisher, reputationHandlers, "Tras el commit")
Rel(eventPublisher, creditVerifierHandler, "VerificationCaseResolved (tras el commit)")

Rel(verifierFacade, repositories, "Usa")
Rel(reputationCommandService, verifierFacade, "Sincronizar el rating (updateRating)")
Rel(disputeCommandService, verifierFacade, "Pedir Verificadores disponibles")

@enduml
