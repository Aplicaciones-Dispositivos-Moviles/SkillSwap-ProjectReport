@startuml AssessmentPeerReviewComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(assessmentBC, "Assessment & Peer Review Bounded Context") {
    Component(assessmentAttemptController, "AssessmentAttempt Controller", "Java Class", "RESTful API Controller")
    Component(verificationCaseController, "VerificationCase Controller", "Java Class", "RESTful API Controller")
    Component(verifierProfileController, "VerifierProfile Controller", "Java Class", "RESTful API Controller")
    Component(assessmentCommandService, "Assessment CommandService", "Java Class", "Lógica de negocio")
    Component(assessmentQueryService, "Assessment QueryService", "Java Class", "Consultas")
    Component(verifierMatcher, "VerifierMatcher", "Java Class", "Asignación por menor carga de casos abiertos, excluyendo al propio estudiante")
    Component(caseAssignmentService, "CaseAssignmentService", "Java Class", "Reasigna casos Pending al activarse disponibilidad")
    Component(attemptRepository, "AssessmentAttempt Repository", "Java Interface", "Interface persistencia")
    Component(verifierProfileRepository, "VerifierProfile Repository", "Java Interface", "Interface persistencia")
    Component(caseRepository, "VerificationCase Repository", "Java Interface", "Interface persistencia")
    Component(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica eventos en proceso tras el commit")
    Component(assessmentContextFacade, "Assessment ContextFacade", "Java Class", "Punto de entrada interno")
    Component(verifierProfileContextFacade, "VerifierProfile ContextFacade", "Java Class", "Expuesto para que Reputation sincronice el rating")
}

Component_Ext(pathEngineContextFacade, "LearningPath ContextFacade", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(identityContextFacade, "Identity ContextFacade", "Java Class", "Bounded Context: Identity & Access")
Component_Ext(reputationCommandService, "Reputation CommandService", "Java Class", "Bounded Context: Reputation")
Component_Ext(reputationEventHandlers, "Reputation EventHandlers", "Java Class", "Bounded Context: Reputation (reacciona a los eventos publicados)")
Component_Ext(recognitionEventHandlers, "Recognition EventHandlers", "Java Class", "Bounded Context: Recognition & Incentives (reacciona a los eventos publicados)")
Component_Ext(moderationQueryService, "Moderation QueryService", "Java Class", "Bounded Context: Moderation & Disputes")
Component_Ext(subscriptionContextFacade, "Subscription ContextFacade", "Java Class", "Bounded Context: Subscription & Billing")

Rel(androidApp, assessmentAttemptController, "Request HTTP a Assessment & Peer Review")
Rel(flutterApp, assessmentAttemptController, "Request HTTP a Assessment & Peer Review")
Rel(androidApp, verificationCaseController, "Request HTTP a Assessment & Peer Review")
Rel(flutterApp, verificationCaseController, "Request HTTP a Assessment & Peer Review")
Rel(androidApp, verifierProfileController, "Request HTTP a Assessment & Peer Review")
Rel(flutterApp, verifierProfileController, "Request HTTP a Assessment & Peer Review")

Rel(assessmentAttemptController, assessmentCommandService, "Usa")
Rel(assessmentAttemptController, assessmentQueryService, "Usa")
Rel(verificationCaseController, assessmentCommandService, "Usa")
Rel(verificationCaseController, assessmentQueryService, "Usa")
Rel(verifierProfileController, assessmentCommandService, "Usa")
Rel(verifierProfileController, assessmentQueryService, "Usa")

Rel(assessmentCommandService, attemptRepository, "Usa")
Rel(assessmentCommandService, verifierProfileRepository, "Usa")
Rel(assessmentCommandService, caseRepository, "Usa")
Rel(assessmentQueryService, attemptRepository, "Usa")
Rel(assessmentQueryService, verifierProfileRepository, "Usa")
Rel(assessmentQueryService, caseRepository, "Usa")

Rel(attemptRepository, mainDB, "SQL Transaction")
Rel(verifierProfileRepository, mainDB, "SQL Transaction")
Rel(caseRepository, mainDB, "SQL Transaction")

Rel(assessmentCommandService, verifierMatcher, "Invoca para asignar un Verificador disponible")
Rel(assessmentCommandService, caseAssignmentService, "Delega asignación y reasignación de casos Pending")

Rel(assessmentCommandService, pathEngineContextFacade, "Pedir AssessmentBlueprint con correctAnswer / Notificar nodo completado")
Rel(assessmentCommandService, subscriptionContextFacade, "Pedir cupo de escalamientos y plazo de revisión del plan")
Rel(assessmentQueryService, identityContextFacade, "Pedir datos de usuario de los Verificadores candidatos")

Rel(assessmentCommandService, domainEventPublisher, "Publica AssessmentAttemptPassed / VerificationCaseResolved")
Rel(domainEventPublisher, reputationEventHandlers, "En proceso, tras el commit")
Rel(domainEventPublisher, recognitionEventHandlers, "En proceso, tras el commit")

Rel(assessmentContextFacade, assessmentCommandService, "Delega")
Rel(assessmentContextFacade, assessmentQueryService, "Delega")
Rel(verifierProfileContextFacade, assessmentCommandService, "Delega UpdateRating")

Rel(moderationQueryService, assessmentContextFacade, "Pedir datos del VerificationCase escalado (vía ACL propio)")
Rel(reputationCommandService, verifierProfileContextFacade, "Sincronizar confiabilidad (UpdateRating)")

@enduml