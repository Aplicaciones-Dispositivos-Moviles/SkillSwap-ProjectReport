@startuml AssessmentPeerReviewComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(assessmentBC, "Assessment & Peer Review Bounded Context") {
    Component(assessmentAttemptController, "AssessmentAttempts Controller", "Java Class", "RESTful API Controller")
    Component(verificationCaseController, "VerificationCases Controller", "Java Class", "RESTful API Controller")
    Component(verifierProfileController, "VerifierProfiles Controller", "Java Class", "RESTful API Controller")
    Component(reviewDeadlinePoliciesController, "ReviewDeadlinePolicies Controller", "Java Class", "GET / PUT /review-deadline-policies")
    Component(attemptCommandService, "AssessmentAttempt CommandService", "Java Class", "Corrige el intento y abre el caso si no aprueba")
    Component(caseCommandService, "VerificationCase CommandService", "Java Class", "Evidencia, decisión, apelación y reasignación por plazo vencido")
    Component(verifierProfileCommandService, "VerifierProfile CommandService", "Java Class", "Alta y disponibilidad del Verificador")
    Component(deadlinePolicyCommandService, "ReviewDeadlinePolicy CommandService", "Java Class", "El Verificador senior define el plazo de cada plan")
    Component(assessmentQueryServices, "Assessment QueryServices", "Java Class", "Intentos, casos, perfiles y políticas de plazo")
    Component(caseAssignmentService, "CaseAssignmentService", "Java Class", "Asigna casos Pending con VerifierMatcher (menor carga)")
    Component(reviewDeadlineResolver, "ReviewDeadlineResolver", "Java Class", "Plazo del plan: política definida o valor por defecto")
    Component(overdueScheduler, "OverdueCaseReassignment Scheduler", "Java Class (@Scheduled)", "Busca casos Assigned con el plazo vencido")
    Component(attemptRepository, "AssessmentAttempt Repository", "Java Interface", "Interface persistencia")
    Component(caseRepository, "VerificationCase Repository", "Java Interface", "Interface persistencia")
    Component(verifierProfileRepository, "VerifierProfile Repository", "Java Interface", "Interface persistencia")
    Component(deadlinePolicyRepository, "ReviewDeadlinePolicy Repository", "Java Interface", "Interface persistencia")
    Component(verifierProfileContextFacade, "VerifierProfile ContextFacade", "Java Class", "updateRating, isEnabledVerifier, getAvailableVerifiers")
}

Component_Ext(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica eventos en proceso tras el commit")
Component_Ext(pathEngineContextFacade, "LearningPath ContextFacade", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(subscriptionContextFacade, "Subscription ContextFacade", "Java Class", "Bounded Context: Subscription & Billing")
Component_Ext(reputationContextFacade, "Reputation ContextFacade", "Java Class", "Bounded Context: Reputation")
Component_Ext(reputationEventHandlers, "Reputation EventHandlers", "Java Class", "Bounded Context: Reputation")
Component_Ext(recognitionEventHandlers, "CreditVerifier EventHandler", "Java Class", "Bounded Context: Recognition & Incentives")
Component_Ext(reputationCommandService, "Reputation CommandService", "Java Class", "Bounded Context: Reputation")
Component_Ext(disputeServices, "Dispute Command/Controller", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(androidApp, assessmentAttemptController, "Request HTTP")
Rel(flutterApp, assessmentAttemptController, "Request HTTP")
Rel(androidApp, verificationCaseController, "Request HTTP")
Rel(androidApp, verifierProfileController, "Request HTTP")
Rel(androidApp, reviewDeadlinePoliciesController, "Request HTTP")

Rel(assessmentAttemptController, attemptCommandService, "Usa")
Rel(verificationCaseController, caseCommandService, "Usa")
Rel(verifierProfileController, verifierProfileCommandService, "Usa")
Rel(reviewDeadlinePoliciesController, deadlinePolicyCommandService, "Usa")
Rel(assessmentAttemptController, assessmentQueryServices, "Usa")
Rel(verificationCaseController, assessmentQueryServices, "Usa")
Rel(reviewDeadlinePoliciesController, assessmentQueryServices, "Usa")

Rel(attemptCommandService, caseAssignmentService, "Asigna el caso abierto")
Rel(verifierProfileCommandService, caseAssignmentService, "Asigna casos Pending al activar disponibilidad")
Rel(caseCommandService, caseAssignmentService, "Reasigna el caso")
Rel(attemptCommandService, reviewDeadlineResolver, "Plazo del caso")
Rel(caseCommandService, reviewDeadlineResolver, "Plazo al reasignar")
Rel(overdueScheduler, caseCommandService, "ReassignOverdueCaseCommand")

Rel(attemptCommandService, attemptRepository, "Usa")
Rel(attemptCommandService, caseRepository, "Usa")
Rel(caseCommandService, caseRepository, "Usa")
Rel(caseAssignmentService, verifierProfileRepository, "Usa")
Rel(deadlinePolicyCommandService, deadlinePolicyRepository, "Usa")
Rel(reviewDeadlineResolver, deadlinePolicyRepository, "Usa")
Rel(attemptRepository, mainDB, "SQL Transaction")
Rel(caseRepository, mainDB, "SQL Transaction")
Rel(verifierProfileRepository, mainDB, "SQL Transaction")
Rel(deadlinePolicyRepository, mainDB, "SQL Transaction")

Rel(attemptCommandService, pathEngineContextFacade, "Blueprint con respuestas / completar nodo")
Rel(caseCommandService, pathEngineContextFacade, "Completar nodo aprobado")
Rel(verifierProfileCommandService, pathEngineContextFacade, "hasCompletedSkill")
Rel(attemptCommandService, subscriptionContextFacade, "Cupo de escalamientos del plan")
Rel(reviewDeadlineResolver, subscriptionContextFacade, "Plan actual del estudiante")
Rel(deadlinePolicyCommandService, reputationContextFacade, "isSeniorVerifier")

Rel(attemptCommandService, domainEventPublisher, "AssessmentAttemptPassed")
Rel(caseCommandService, domainEventPublisher, "VerificationCaseResolved / VerificationCaseDeadlineMissed")
Rel(domainEventPublisher, reputationEventHandlers, "Los tres eventos")
Rel(domainEventPublisher, recognitionEventHandlers, "VerificationCaseResolved")

Rel(reputationCommandService, verifierProfileContextFacade, "updateRating")
Rel(disputeServices, verifierProfileContextFacade, "Verificadores habilitados y su carga")

@enduml
