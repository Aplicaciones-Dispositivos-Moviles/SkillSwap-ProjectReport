@startuml CredentialVerificationComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart", "Leen el certificado con ML Kit en el dispositivo (OCR on-device)")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(cloudStorage, "Cloudinary", "Almacenamiento de archivos")

Container_Boundary(credentialBC, "Credential Verification Bounded Context") {
    Component(certificatesController, "CertificatesController", "Java Class", "POST multipart: archivo (JPG, PNG o PDF ≤ 10 MB) + campos leídos por el OCR del dispositivo")
    Component(certificateCommandService, "CertificateCommandService", "Java Class", "Registra el certificado, evalúa el riesgo y resuelve los sospechosos")
    Component(certificateQueryService, "CertificateQueryService", "Java Class", "Consultas y URL del archivo")
    Component(riskScorer, "CertificateRiskScorer", "Domain Service", "Puntúa el riesgo: duplicados (número, código, archivo), inconsistencias del OCR y titular distinto")
    Component(holderNameMatcher, "HolderNameMatcher", "Domain Service", "Compara el titular con el nombre registrado")
    Component(fileStorage, "FileStorageService", "Java Interface", "Puerto de almacenamiento de archivos")
    Component(cloudinaryAdapter, "CloudinaryStorageService", "Java Class", "Adaptador de Cloudinary")
    Component(certificateRepository, "CertificateRepository", "Java Interface", "Interface persistencia")
    Component(notifyHandler, "NotifyCertificateResolutionEventHandler", "Java Class", "Avisa al estudiante el resultado del certificado sospechoso")
    Component(credentialFacade, "CredentialContextFacade", "Java Class", "Certificados validados, evidencia y resolución de sospechosos")
}

Component_Ext(iamFacade, "IamContextFacade", "Java Class", "Bounded Context: Identity & Access")
Component_Ext(notificationsFacade, "UserNotificationsContextFacade", "Java Class", "Bounded Context: Identity & Access")
Component_Ext(recognizeCertificateHandler, "RecognizeValidatedCertificateEventHandler", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(learningPathCommandService, "LearningPathCommandService", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(escalateHandler, "EscalateCertificateReviewEventHandler", "Java Class", "Bounded Context: Moderation & Disputes")
Component_Ext(disputeServices, "Dispute Command/QueryService", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(mobileApps, certificatesController, "Sube el certificado con los campos del OCR", "HTTPS multipart")
Rel(certificatesController, certificateCommandService, "Usa")
Rel(certificatesController, certificateQueryService, "Usa")

Rel(certificateCommandService, riskScorer, "Evalúa el riesgo")
Rel(certificateCommandService, holderNameMatcher, "Compara el titular")
Rel_U(certificateCommandService, iamFacade, "Pedir el nombre registrado del estudiante")
Rel(certificateCommandService, fileStorage, "Guarda el archivo")
Rel(certificateQueryService, fileStorage, "Obtiene la URL")
Rel(cloudinaryAdapter, fileStorage, "Implementa")
Rel_D(cloudinaryAdapter, cloudStorage, "Sube el documento", "HTTPS")
Rel(certificateCommandService, certificateRepository, "Usa")
Rel(certificateQueryService, certificateRepository, "Usa")
Rel(certificateRepository, mainDB, "SQL Transaction")

Rel_U(certificateCommandService, recognizeCertificateHandler, "CertificateVerified (tras el commit; sospechoso confirmado como auténtico)")
Rel_U(certificateCommandService, escalateHandler, "CertificateFlaggedSuspicious (tras el commit)")
Rel(certificateCommandService, notifyHandler, "CertificateVerificationResolved (tras el commit)")
Rel(notifyHandler, notificationsFacade, "Enviar push al estudiante")

Rel(credentialFacade, certificateCommandService, "Delega")
Rel(credentialFacade, certificateQueryService, "Delega")
Rel(learningPathCommandService, credentialFacade, "Pedir certificados validados y evidencia del estudiante")
Rel(disputeServices, credentialFacade, "Pedir el certificado a revisar / enviar la resolución del Verificador senior")

@enduml
