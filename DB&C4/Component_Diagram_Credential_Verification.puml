@startuml CredentialVerificationComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(apiGateway, "Api Gateway", "ASP.NET Core (C#)")
ContainerDb_Ext(mainDB, "SkillSwap Database", "MySQL 8")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR/Barcode Scanning")
System_Ext(cloudStorage, "Cloudinary", "Cloud Storage")

Container_Boundary(credentialBC, "Credential Verification Bounded Context") {
    Component(certificateController, "Certificate Controller", "C# Class", "RESTful API Controller")
    Component(certificateCommandService, "Certificate CommandService", "C# Class", "Lógica de negocio: subida, extracción y evaluación de riesgo")
    Component(certificateQueryService, "Certificate QueryService", "C# Class", "Consultas")
    Component(certificateRepository, "Certificate Repository", "C# Interface", "Interface persistencia")
    Component(mlKitExtractorExternal, "MlKit ExternalService", "C# Class", "Adaptador de extracción OCR")
    Component(cloudinaryStorageExternal, "Cloudinary ExternalService", "C# Class", "Adaptador de almacenamiento de archivos")
    Component(certificateContextFacade, "Certificate ContextFacade", "C# Class", "Punto de entrada interno")
}

Component_Ext(moderationContextFacade, "Moderation ContextFacade", "C# Class", "Bounded Context: Moderation & Disputes")
Component_Ext(pathEngineQueryService, "Learning Path QueryService", "C# Class", "Bounded Context: Learning Path Engine")
Component_Ext(moderationCommandService, "Moderation CommandService", "C# Class", "Bounded Context: Moderation & Disputes")

Rel(apiGateway, certificateController, "Request HTTP a Credential Verification")
Rel(certificateController, certificateCommandService, "Usa")
Rel(certificateController, certificateQueryService, "Usa")
Rel(certificateCommandService, certificateRepository, "Usa")
Rel(certificateQueryService, certificateRepository, "Usa")
Rel(certificateRepository, mainDB, "SQL Transaction")

Rel(certificateCommandService, mlKitExtractorExternal, "Delega extracción OCR")
Rel(mlKitExtractorExternal, mlKitService, "Ejecuta Text Recognition / Barcode Scanning on-device")

Rel(certificateCommandService, cloudinaryStorageExternal, "Delega almacenamiento del archivo")
Rel(cloudinaryStorageExternal, cloudStorage, "Sube el documento")

Rel(certificateCommandService, moderationContextFacade, "Escala certificado en estado SUSPICIOUS")

Rel(certificateContextFacade, certificateCommandService, "Delega")
Rel(certificateContextFacade, certificateQueryService, "Delega")

Rel(pathEngineQueryService, certificateContextFacade, "Pedir certificados verificados del Estudiante")
Rel(moderationCommandService, certificateContextFacade, "Enviar resolución de la disputa sobre el certificado")

@enduml