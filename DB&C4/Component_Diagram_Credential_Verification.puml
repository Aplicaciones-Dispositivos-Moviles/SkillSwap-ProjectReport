@startuml CredentialVerificationComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR/Barcode Scanning en las apps")
System_Ext(cloudStorage, "Cloudinary", "Cloud Storage")

Container_Boundary(credentialBC, "Credential Verification Bounded Context") {
    Component(certificateController, "Certificates Controller", "Java Class", "POST (multipart), GET /{id}, GET")
    Component(certificateCommandService, "Certificate CommandService", "Java Class", "Subida, datos extraídos, riesgo, comparación del titular y resolución")
    Component(certificateQueryService, "Certificate QueryService", "Java Class", "Consultas")
    Component(riskScorer, "CertificateRiskScorer", "Domain Service", "Puntaje de riesgo y nivel (LowRisk / Review / HighRisk)")
    Component(holderNameMatcher, "HolderNameMatcher", "Domain Service", "Compara el titular leído con el nombre completo registrado")
    Component(fileStorage, "FileStorageService", "Java Interface", "Puerto de almacenamiento del archivo")
    Component(cloudinaryStorage, "CloudinaryStorageService", "Java Class", "Adaptador de almacenamiento")
    Component(certificateRepository, "Certificate Repository", "Java Interface", "Interface persistencia")
    Component(notifyHandler, "NotifyCertificateResolution EventHandler", "Java Class", "Reacciona a CertificateVerificationResolved")
    Component(credentialContextFacade, "Credential ContextFacade", "Java Class", "Evidencia, certificados validados, revisión y resolución de sospechosos")
}

Component_Ext(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica eventos en proceso tras el commit")
Component_Ext(iamContextFacade, "Iam ContextFacade", "Java Class", "Bounded Context: Identity & Access")
Component_Ext(userNotificationsFacade, "UserNotifications ContextFacade", "Java Class", "Bounded Context: Identity & Access")
Component_Ext(escalateHandler, "EscalateCertificateReview EventHandler", "Java Class", "Bounded Context: Moderation & Disputes")
Component_Ext(recognizeCertificateHandler, "RecognizeValidatedCertificate EventHandler", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(pathEngineCommandService, "LearningPath CommandService", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(disputeServices, "Dispute Command/QueryService", "Java Class", "Bounded Context: Moderation & Disputes")

Rel(androidApp, mlKitService, "Extrae texto y QR del certificado")
Rel(flutterApp, mlKitService, "Extrae texto y QR del certificado")
Rel(androidApp, certificateController, "Request HTTP (archivo + datos extraídos)")
Rel(flutterApp, certificateController, "Request HTTP (archivo + datos extraídos)")

Rel(certificateController, certificateCommandService, "Usa")
Rel(certificateController, certificateQueryService, "Usa")
Rel(certificateCommandService, certificateRepository, "Usa")
Rel(certificateQueryService, certificateRepository, "Usa")
Rel(certificateRepository, mainDB, "SQL Transaction")

Rel(certificateCommandService, riskScorer, "Evalúa el riesgo")
Rel(certificateCommandService, holderNameMatcher, "Compara titular y nombre registrado")
Rel(certificateCommandService, iamContextFacade, "getRegisteredFullName")
Rel(certificateCommandService, fileStorage, "Guarda el archivo")
Rel(fileStorage, cloudinaryStorage, "Implementado por")
Rel(cloudinaryStorage, cloudStorage, "Sube el documento", "HTTPS")

Rel(certificateCommandService, domainEventPublisher, "CertificateFlaggedSuspicious / CertificateVerified / CertificateVerificationResolved")
Rel(domainEventPublisher, escalateHandler, "CertificateFlaggedSuspicious (escala al Verificador senior)")
Rel(domainEventPublisher, recognizeCertificateHandler, "CertificateVerified")
Rel(domainEventPublisher, notifyHandler, "CertificateVerificationResolved")
Rel(notifyHandler, userNotificationsFacade, "Push al dueño con el resultado")

Rel(credentialContextFacade, certificateCommandService, "Delega")
Rel(credentialContextFacade, certificateQueryService, "Delega")
Rel(pathEngineCommandService, credentialContextFacade, "Certificados validados y evidencia")
Rel(disputeServices, credentialContextFacade, "getCertificateForReview / resolveSuspiciousCertificate")

@enduml
