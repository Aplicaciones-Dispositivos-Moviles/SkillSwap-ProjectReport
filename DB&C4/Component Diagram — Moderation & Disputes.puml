@startuml ModerationDisputesComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(moderationBC, "Moderation & Disputes Bounded Context") {
    Component(disputesController, "Disputes Controller", "Java Class", "GET /api/v1/disputes, GET /{id}/evidence, PATCH /{id}/resolve")
    Component(disputeCommandService, "Dispute CommandService", "Java Class", "Escala, asigna revisor y resuelve la disputa")
    Component(disputeQueryService, "Dispute QueryService", "Java Class", "Disputas del revisor y evidencia del certificado")
    Component(escalateHandler, "EscalateCertificateReview EventHandler", "Java Class", "Reacciona a CertificateFlaggedSuspicious")
    Component(pendingScheduler, "PendingDisputeAssignment Scheduler", "Java Class (@Scheduled)", "Reintenta asignar las disputas sin revisor")
    Component(reviewerSelector, "DisputeReviewerSelector", "Domain Service", "Verificador senior con menor carga; si no hay, otro Verificador habilitado")
    Component(resolutionValidator, "DisputeResolutionValidator", "Domain Service", "Outcome válido según el origen de la disputa")
    Component(disputeRepository, "Dispute Repository", "Java Interface", "Interface persistencia")
}

Component_Ext(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Evento publicado por Credential Verification")
Component_Ext(credentialContextFacade, "Credential ContextFacade", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(reputationContextFacade, "Reputation ContextFacade", "Java Class", "Bounded Context: Reputation")
Component_Ext(verifierProfileContextFacade, "VerifierProfile ContextFacade", "Java Class", "Bounded Context: Assessment & Peer Review")

Rel(androidApp, disputesController, "Request HTTP a Moderation & Disputes")
Rel(flutterApp, disputesController, "Request HTTP a Moderation & Disputes")

Rel(disputesController, disputeQueryService, "Usa")
Rel(disputesController, disputeCommandService, "ResolveDisputeCommand (outcome, resolutionNotes)")
Rel(disputesController, verifierProfileContextFacade, "isEnabledVerifier")

Rel(domainEventPublisher, escalateHandler, "CertificateFlaggedSuspicious")
Rel(escalateHandler, disputeCommandService, "EscalateCertificateReviewCommand")
Rel(pendingScheduler, disputeCommandService, "AssignPendingDisputesCommand")

Rel(disputeCommandService, reviewerSelector, "Elige el revisor")
Rel(disputeCommandService, resolutionValidator, "Valida la resolución")
Rel(disputeCommandService, disputeRepository, "Usa")
Rel(disputeQueryService, disputeRepository, "Usa")
Rel(disputeRepository, mainDB, "SQL Transaction")

Rel(disputeCommandService, verifierProfileContextFacade, "getAvailableVerifiers (carga de trabajo)")
Rel(disputeCommandService, reputationContextFacade, "findSeniorVerifiers")
Rel(disputeCommandService, credentialContextFacade, "resolveSuspiciousCertificate (Upheld: Verified / Overturned: Rejected)")
Rel(disputeQueryService, credentialContextFacade, "getCertificateForReview (evidencia)")

@enduml
