@startuml ModerationDisputesComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart", "Usadas por el Verificador senior")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(moderationBC, "Moderation & Disputes Bounded Context") {
    Component(disputesController, "DisputesController", "Java Class", "Disputas asignadas, evidencia del certificado y resolución (outcome + resolutionNotes)")
    Component(escalateHandler, "EscalateCertificateReviewEventHandler", "Java Class", "Abre una disputa CertificateReview por cada certificado sospechoso")
    Component(pendingScheduler, "PendingDisputeAssignmentScheduler", "Java Class", "Reintenta asignar las disputas sin revisor")
    Component(disputeCommandService, "DisputeCommandService", "Java Class", "Abre, asigna y resuelve disputas")
    Component(disputeQueryService, "DisputeQueryService", "Java Class", "Disputas y evidencia del certificado")
    Component(reviewerSelector, "DisputeReviewerSelector", "Domain Service", "Verificador senior con menos carga; si no hay, el Verificador disponible con menos carga (nunca una de las partes)")
    Component(resolutionValidator, "DisputeResolutionValidator", "Domain Service", "Outcomes válidos según el origen (Upheld / Overturned para certificados)")
    Component(disputeRepository, "DisputeRepository", "Java Interface", "Interface persistencia (disputes)")
}

Component_Ext(credentialPublisher, "DomainEventPublisher", "Java Class (Shared)", "Bounded Context: Credential Verification")
Component_Ext(credentialFacade, "CredentialContextFacade", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(verifierFacade, "VerifierProfileContextFacade", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(reputationFacade, "ReputationContextFacade", "Java Class", "Bounded Context: Reputation")

Rel(mobileApps, disputesController, "Request HTTP", "HTTPS/JSON")
Rel(disputesController, disputeCommandService, "Usa")
Rel(disputesController, disputeQueryService, "Usa")
Rel(disputesController, verifierFacade, "¿Es Verificador habilitado?")

Rel(credentialPublisher, escalateHandler, "CertificateFlaggedSuspicious (tras el commit)")
Rel(escalateHandler, disputeCommandService, "Abre la disputa")
Rel(pendingScheduler, disputeCommandService, "Asigna las pendientes")

Rel(disputeCommandService, reviewerSelector, "Elige al revisor")
Rel(disputeCommandService, resolutionValidator, "Valida la resolución")
Rel(disputeCommandService, disputeRepository, "Usa")
Rel(disputeQueryService, disputeRepository, "Usa")
Rel(disputeRepository, mainDB, "SQL Transaction")

Rel(disputeCommandService, verifierFacade, "Pedir Verificadores disponibles y su carga")
Rel(disputeCommandService, reputationFacade, "¿Cuáles son senior?")
Rel(disputeCommandService, credentialFacade, "Enviar la resolución (auténtico o fraudulento)")
Rel(disputeQueryService, credentialFacade, "Pedir el certificado a revisar")

@enduml
