@startuml db-reputation-mobile
!pragma layout smetana
hide circle
hide stereotype
skinparam shadowing false
skinparam roundCorner 8
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 55
skinparam ArrowColor #546E7A
skinparam ArrowFontSize 11
skinparam ArrowFontColor #37474F
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  HeaderBackgroundColor #ECEFF1
  FontStyle bold
  FontSize 13
  AttributeFontSize 12
}
skinparam class<<ext>> {
  BackgroundColor #F5F5F5
  BorderColor #9E9E9E
  FontColor #616161
  AttributeFontColor #757575
}
skinparam package {
  BorderColor #90A4AE
  FontSize 14
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 11
}

title Base de datos — Reputation

package "Reputation" #FCE4EC {
entity "student_employability_scores" as student_employability_scores {
  * id : integer <<PK>>
  --
  * student_id : integer <<UK, ref>>
  * verified_skills_count : integer
  * score : integer
  * updated_at : timestamptz
}
entity "verifier_reliabilities" as verifier_reliabilities {
  * id : integer <<PK>>
  --
  * verifier_user_id : integer <<UK, ref>>
  * resolved_cases_count : integer
  * overturned_decisions_count : integer
  * sanctions_count : integer
  * score : integer
  * updated_at : timestamptz
  * missed_deadlines_count : integer <color:#6D4C41><size:11>{default 0}</size></color>
}
}

entity "users\n<size:10>(Identity & Access)</size>" as ext_users <<ext>> #F5F5F5;line.dashed;line:9E9E9E {
  * id : integer <<PK>>
}

ext_users ||..o| student_employability_scores : "student_id"
ext_users ||..o| verifier_reliabilities : "verifier_user_id"

legend bottom left
  <b>●</b> NOT NULL   <b>PK</b> clave primaria   <b>FK</b> clave foránea   <b>UK</b> única   <b>ref</b> id de otra tabla sin FK
  <b>timestamptz</b> = timestamp with time zone. Entre llaves: valores o regla del CHECK de la columna.
  Línea continua: FOREIGN KEY real.   Línea punteada: referencia por id sin FOREIGN KEY; en gris, tablas de otro Bounded Context (solo su id).
endlegend

@enduml
