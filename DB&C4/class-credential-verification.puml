@startuml class-credential-verification-mobile
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam dpi 110
left to right direction

' Fuente: SkillSwap-WebServices-Java, credentialverification. El backend no ejecuta OCR:
' los campos extraidos por ML Kit en el dispositivo llegan en el multipart.
!startsub BODY
package "Credential Verification" {
    class Certificate <<Aggregate Root>> {
        -id: Integer
        -ownerId: int
        -holderName: String
        -institutionName: String
        -courseName: String
        -issueDate: LocalDate
        -durationHours: Integer
        -certificateNumber: String
        -verificationCode: String
        -verificationUrl: String
        -qrPayload: String
        -ocrText: String
        -fileHash: String
        -storageReference: String
        -status: VerificationStatus
        -verificationMethod: VerificationMethod
        -riskAssessment: RiskAssessment
        -holderNameMismatch: boolean
        -createdAt: Instant
        -verifiedAt: Instant
        +applyExtractedData(holderName, institutionName, courseName, ..., ocrText): Certificate
        +hasOcrInconsistencies(today: LocalDate): boolean
        +flagHolderNameMismatch(): Certificate
        +assessRisk(riskAssessment: RiskAssessment): Certificate
        +resolveDispute(isAuthentic: boolean): Certificate
    }

    class RiskAssessment <<Value Object>> {
        +score: int
        +level(): RiskLevel
    }

    enum RiskLevel {
        LOW_RISK
        REVIEW
        HIGH_RISK
    }

    enum VerificationStatus {
        PENDING
        UNVERIFIED
        SUSPICIOUS
        VERIFIED
        REJECTED
    }

    enum VerificationMethod {
        OCR_ONLY
        QR
        ISSUER_URL
        OFFICIAL_REGISTRY
        MANUAL
    }

    interface CertificateRiskScorer <<Domain Service>> {
        ..
        +calculateRisk(duplicateCertificateNumber: boolean,
        \t duplicateVerificationCode: boolean, duplicateFileHash: boolean,
        \t ocrInconsistencies: boolean, holderNameMismatch: boolean): RiskAssessment
    }

    class HolderNameMatcher <<Domain Service>> {
        +{static} matches(certificateHolder: String, registeredName: String): boolean
    }

    interface FileStorageService <<Port>> {
        +upload(content: byte[], contentType: String, fileKey: String): String
        +getTemporaryUrl(storageReference: String, validFor: Duration): String
        +delete(storageReference: String): void
    }

    class CloudinaryStorageService

    note as OcrNote
        Los campos extraídos (OCR y QR) llegan
        en el multipart desde la app: ML Kit
        se ejecuta en el dispositivo.
    end note

    Certificate --> RiskAssessment
    Certificate --> VerificationStatus
    Certificate --> VerificationMethod
    RiskAssessment --> RiskLevel
    CertificateRiskScorer ..> RiskAssessment
    CloudinaryStorageService ..|> FileStorageService
    OcrNote .. Certificate
}
!endsub
@enduml
