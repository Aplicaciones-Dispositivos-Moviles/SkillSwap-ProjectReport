@startuml SkillSwapContextMapping
!pragma layout smetana

skinparam backgroundColor transparent
skinparam rectangle {
    RoundCorner 12
    BorderColor #333333
    FontStyle bold
}

skinparam rectangle<<upstream>> {
    BackgroundColor #4A90D9
    FontColor white
    BorderColor #2C5F8A
}

skinparam rectangle<<downstream>> {
    BackgroundColor #ECECEC
    FontColor #333333
    BorderColor #999999
}

skinparam rectangle<<external>> {
    BackgroundColor #8C8C8C
    FontColor white
    BorderColor #5C5C5C
}

skinparam nodesep 70
skinparam ranksep 90

' ===== Fila superior: sistemas externos =====
rectangle "ML Kit" as MLK <<external>>
rectangle "Gemini API" as GEM <<external>>

' ===== Fila central: núcleo del dominio =====
rectangle "Credential\nVerification" as CV <<upstream>>
rectangle "Learning Path\nEngine" as LPE <<upstream>>
rectangle "Assessment &\nPeer Review" as APR <<upstream>>
rectangle "Reputation" as REP <<downstream>>

' ===== Fila inferior: soporte y genéricos =====
rectangle "Moderation &\nDisputes" as MOD <<upstream>>
rectangle "Identity & Access" as IAM <<upstream>>
rectangle "Subscription &\nBilling" as SUB <<upstream>>
rectangle "Recognition &\nIncentives" as REC <<downstream>>
rectangle "Google Play Billing\n(vía RevenueCat)" as GPB <<external>>

' ===== Layout: forzar filas con enlaces invisibles =====
MLK -[hidden]right-> GEM
MOD -[hidden]right-> IAM
IAM -[hidden]right-> SUB
SUB -[hidden]right-> REC
REP -[hidden]down-> REC

' ===== Relaciones reales =====

' Núcleo: Credential Verification -> Learning Path Engine -> Assessment & Peer Review
CV -right-> LPE : [Customer/Supplier]
LPE -right-> APR : [Customer/Supplier]
CV .up.> MLK : [Anticorruption\nLayer]
LPE .up.> GEM : [Anticorruption\nLayer]

' Identity & Access como Upstream/Conformist hacia todos
IAM -up-> CV : [Conformist]
IAM -up-> LPE : [Conformist]
IAM -up-> APR : [Conformist]
IAM -right-> REP : [Conformist]
IAM -right-> REC : [Conformist]
IAM -left-> MOD : [Conformist]
IAM -right-> SUB : [Conformist]

' Assessment & Peer Review hacia Reputation y Recognition & Incentives (eventos de dominio)
APR .right.> REP : [Customer/Supplier]\n(eventos de dominio)
APR .right.> REC : [Customer/Supplier]\n(eventos de dominio)

' Reputation hacia Assessment & Peer Review (sincroniza rating, vía ACL)
REP .left.> APR : [Anticorruption\nLayer]

' Moderation & Disputes
MOD -right-> IAM : [Customer/Supplier]
MOD -right-> REP : [Customer/Supplier]
MOD .up.> APR : [Anticorruption\nLayer]

' Subscription & Billing (independiente de Recognition & Incentives)
SUB .down.> GPB : [Anticorruption\nLayer]

' Subscription & Billing expone los límites del plan vigente (SubscriptionContextFacade -> PlanLimitsView);
' Learning Path Engine y Assessment & Peer Review los traducen a sus propias reglas (rutas activas/totales,
' cupo mensual de escalamientos y plazo de revisión)
SUB .up.> LPE : [Anticorruption Layer]\n(PlanLimitsView)
SUB .up.> APR : [Anticorruption Layer]\n(PlanLimitsView)

@enduml
