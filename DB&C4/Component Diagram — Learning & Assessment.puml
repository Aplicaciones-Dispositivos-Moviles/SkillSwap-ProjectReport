@startuml LearningPathEngineComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(geminiApi, "Gemini API", "Interpretación de la meta sobre el catálogo interno y generación de preguntas")

Container_Boundary(pathEngineBC, "Learning Path Engine Bounded Context") {
    Component(learningPathController, "LearningPaths Controller", "Java Class", "Declarar meta, listar, pausar y reanudar rutas")
    Component(pathNodeCertificatesController, "PathNodeCertificates Controller", "Java Class", "POST /path-nodes/{nodeId}/certificate")
    Component(assessmentBlueprintController, "AssessmentBlueprints Controller", "Java Class", "POST /path-nodes/{nodeId}/assessment-blueprint")
    Component(advancedPathUnlocksController, "AdvancedPathUnlocks Controller", "Java Class", "GET /advanced-path-unlocks")
    Component(pathEngineCommandService, "LearningPath CommandService", "Java Class", "Rutas, límites del plan, certificados como evidencia y rutas avanzadas")
    Component(blueprintCommandService, "AssessmentBlueprint CommandService", "Java Class", "Genera el quiz del nodo sin repetir preguntas")
    Component(pathEngineQueryService, "LearningPath QueryService", "Java Class", "Consultas")
    Component(skillTaxonomyMatcher, "SkillTaxonomyMatcher", "Java Interface", "Puerto que resuelve texto libre contra el catálogo interno de habilidades")
    Component(geminiMatcher, "GeminiSkillTaxonomyMatcher", "Java Class", "Selecciona solo tags del catálogo; respaldo KeywordSkillTaxonomyMatcher")
    Component(questionGenerator, "GeminiQuestionGenerator", "Java Class", "Implementa QuestionGenerationService")
    Component(geminiClient, "GeminiClient", "Java Class", "Cliente HTTP compartido (reintentos y modelos de respaldo)")
    Component(learningPathRepository, "LearningPath Repository", "Java Interface", "Interface persistencia")
    Component(assessmentBlueprintRepository, "AssessmentBlueprint Repository", "Java Interface", "Interface persistencia")
    Component(advancedPathUnlockRepository, "AdvancedPathUnlock Repository", "Java Interface", "Interface persistencia")
    Component(enforcePlanLimitsHandler, "EnforcePlanLimits EventHandler", "Java Class", "SubscriptionExpired: pausa las rutas activas adicionales")
    Component(recognizeCertificateHandler, "RecognizeValidatedCertificate EventHandler", "Java Class", "CertificateVerified: completa el nodo de la habilidad certificada")
    Component(grantUnlockHandler, "GrantAdvancedPathUnlock EventHandler", "Java Class", "AdvancedPathUnlockRedeemed: registra el AdvancedPathUnlock")
    Component(pathEngineContextFacade, "LearningPath ContextFacade", "Java Class", "Blueprint del nodo y completar nodo")
    Component(skillCatalogFacade, "SkillCatalog ContextFacade", "Java Class", "Tags del catálogo para un texto")
}

Component_Ext(domainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Eventos de Subscription & Billing, Credential Verification y Recognition & Incentives")
Component_Ext(credentialContextFacade, "Credential ContextFacade", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(subscriptionContextFacade, "Subscription ContextFacade", "Java Class", "Bounded Context: Subscription & Billing")
Component_Ext(recognitionContextFacade, "Recognition ContextFacade", "Java Class", "Bounded Context: Recognition & Incentives")
Component_Ext(assessmentCommandService, "Assessment CommandServices", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(userCommandService, "User CommandService", "Java Class", "Bounded Context: Identity & Access")

Rel(androidApp, learningPathController, "Request HTTP")
Rel(flutterApp, learningPathController, "Request HTTP")
Rel(androidApp, pathNodeCertificatesController, "Request HTTP")
Rel(androidApp, assessmentBlueprintController, "Request HTTP")
Rel(androidApp, advancedPathUnlocksController, "Request HTTP")

Rel(learningPathController, pathEngineCommandService, "Usa")
Rel(learningPathController, pathEngineQueryService, "Usa")
Rel(pathNodeCertificatesController, pathEngineCommandService, "Vincula un certificado validado al nodo")
Rel(advancedPathUnlocksController, pathEngineCommandService, "Sincroniza y lista los unlocks")
Rel(assessmentBlueprintController, blueprintCommandService, "Usa")

Rel(pathEngineCommandService, learningPathRepository, "Usa")
Rel(pathEngineCommandService, advancedPathUnlockRepository, "Usa")
Rel(blueprintCommandService, assessmentBlueprintRepository, "Usa")
Rel(pathEngineQueryService, learningPathRepository, "Usa")
Rel(learningPathRepository, mainDB, "SQL Transaction")
Rel(assessmentBlueprintRepository, mainDB, "SQL Transaction")
Rel(advancedPathUnlockRepository, mainDB, "SQL Transaction")

Rel(pathEngineCommandService, skillTaxonomyMatcher, "Interpreta la meta")
Rel(skillCatalogFacade, skillTaxonomyMatcher, "Usa")
Rel(skillTaxonomyMatcher, geminiMatcher, "Implementado por")
Rel(blueprintCommandService, questionGenerator, "Genera preguntas por skillTag")
Rel(geminiMatcher, geminiClient, "Usa")
Rel(questionGenerator, geminiClient, "Usa")
Rel(geminiClient, geminiApi, "generateContent (JSON)", "HTTPS")

Rel(pathEngineCommandService, subscriptionContextFacade, "Límites de rutas del plan")
Rel(pathEngineCommandService, credentialContextFacade, "Certificados validados y evidencia")
Rel(pathEngineCommandService, recognitionContextFacade, "Canjes de ruta avanzada del estudiante")

Rel(domainEventPublisher, enforcePlanLimitsHandler, "SubscriptionExpired")
Rel(domainEventPublisher, recognizeCertificateHandler, "CertificateVerified")
Rel(domainEventPublisher, grantUnlockHandler, "AdvancedPathUnlockRedeemed")
Rel(enforcePlanLimitsHandler, pathEngineCommandService, "EnforcePlanLimitsCommand")
Rel(recognizeCertificateHandler, pathEngineCommandService, "RecognizeValidatedCertificateCommand")
Rel(grantUnlockHandler, pathEngineCommandService, "GrantAdvancedPathUnlockCommand")

Rel(pathEngineContextFacade, pathEngineCommandService, "Delega")
Rel(pathEngineContextFacade, pathEngineQueryService, "Delega")
Rel(assessmentCommandService, pathEngineContextFacade, "Blueprint con respuestas / completar nodo")
Rel(userCommandService, skillCatalogFacade, "skillVector de intereses y bio")

@enduml
