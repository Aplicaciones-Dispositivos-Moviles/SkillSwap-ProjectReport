@startuml LearningPathEngineComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")
System_Ext(geminiApi, "Gemini API", "Interpretación de la meta sobre el catálogo interno y generación de preguntas")

Container_Boundary(pathEngineBC, "Learning Path Engine Bounded Context") {
    Component(learningPathController, "LearningPath Controller", "Java Class", "RESTful API Controller")
    Component(assessmentBlueprintController, "AssessmentBlueprint Controller", "Java Class", "RESTful API Controller")
    Component(pathEngineCommandService, "PathEngine CommandService", "Java Class", "Lógica de negocio")
    Component(pathEngineQueryService, "PathEngine QueryService", "Java Class", "Consultas")
    Component(skillTaxonomyMatcher, "SkillTaxonomy Matcher", "Java Interface", "Puerto que resuelve CareerGoal solo contra el catálogo interno de habilidades (adaptadores Gemini y por palabras clave)")
    Component(learningPathRepository, "LearningPath Repository", "Java Interface", "Interface persistencia")
    Component(assessmentBlueprintRepository, "AssessmentBlueprint Repository", "Java Interface", "Interface persistencia")
    Component(llmGeneratorExternal, "GeminiQuestionGenerator ExternalService", "Java Class", "Adaptador de generación de preguntas")
    Component(enforcePlanLimitsHandler, "EnforcePlanLimitsEventHandler", "Java Class", "Pausa las rutas activas adicionales al vencer el plan mensual")
    Component(pathEngineContextFacade, "PathEngine ContextFacade", "Java Class", "Punto de entrada interno")
}

Component_Ext(credentialContextFacade, "Certificate ContextFacade", "Java Class", "Bounded Context: Credential Verification")
Component_Ext(credentialCommandService, "Certificate CommandService", "Java Class", "Bounded Context: Credential Verification")

Component_Ext(assessmentQueryService, "Assessment QueryService", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(assessmentCommandService, "Assessment CommandService", "Java Class", "Bounded Context: Assessment & Peer Review")
Component_Ext(subscriptionContextFacade, "Subscription ContextFacade", "Java Class", "Bounded Context: Subscription & Billing")
Component_Ext(subscriptionCommandService, "Subscription CommandService", "Java Class", "Bounded Context: Subscription & Billing")

Rel(androidApp, learningPathController, "Request HTTP a Learning Path Engine")
Rel(flutterApp, learningPathController, "Request HTTP a Learning Path Engine")
Rel(androidApp, assessmentBlueprintController, "Request HTTP a Learning Path Engine")
Rel(flutterApp, assessmentBlueprintController, "Request HTTP a Learning Path Engine")

Rel(learningPathController, pathEngineCommandService, "Usa")
Rel(learningPathController, pathEngineQueryService, "Usa")
Rel(assessmentBlueprintController, pathEngineCommandService, "Usa")

Rel(pathEngineCommandService, learningPathRepository, "Usa")
Rel(pathEngineCommandService, assessmentBlueprintRepository, "Usa")
Rel(pathEngineQueryService, learningPathRepository, "Usa")
Rel(learningPathRepository, mainDB, "SQL Transaction")
Rel(assessmentBlueprintRepository, mainDB, "SQL Transaction")

Rel(pathEngineCommandService, skillTaxonomyMatcher, "Resuelve el texto libre de la meta contra la taxonomía interna")
Rel(pathEngineCommandService, llmGeneratorExternal, "Delega generación de preguntas")
Rel(llmGeneratorExternal, geminiApi, "Genera preguntas vía prompt estructurado por skillTag")
Rel(skillTaxonomyMatcher, geminiApi, "Selecciona habilidades solo del catálogo interno (respaldo por palabras clave)")
Rel(pathEngineCommandService, subscriptionContextFacade, "Pedir límites de rutas del plan")
Rel(subscriptionCommandService, enforcePlanLimitsHandler, "SubscriptionExpired")
Rel(enforcePlanLimitsHandler, pathEngineCommandService, "EnforcePlanLimitsCommand")

Rel(pathEngineCommandService, credentialContextFacade, "Pedir certificados verificados del estudiante")

Rel(pathEngineContextFacade, pathEngineCommandService, "Delega")
Rel(pathEngineContextFacade, pathEngineQueryService, "Delega")

Rel(credentialCommandService, pathEngineContextFacade, "Notificar certificado verificado (recalcular ruta)")
Rel(assessmentQueryService, pathEngineContextFacade, "Pedir AssessmentBlueprint del nodo")
Rel(assessmentCommandService, pathEngineContextFacade, "Notificar nodo demostrado / caso resuelto")

@enduml