@startuml db-full-mobile
!pragma layout smetana
hide circle
hide stereotype
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 55
skinparam ArrowColor #546E7A
skinparam ArrowFontSize 11
skinparam ArrowFontColor #37474F
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  HeaderBackgroundColor #ECEFF1
  FontStyle bold
  FontSize 13
  AttributeFontSize 12
}
skinparam class<<ext>> {
  BackgroundColor #F5F5F5
  BorderColor #9E9E9E
  FontColor #616161
  AttributeFontColor #757575
}
skinparam package {
  BorderColor #90A4AE
  FontSize 14
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 11
}

title SkillSwap — Base de datos (PostgreSQL 16, migraciones Flyway V1–V10)

package "Identity & Access" #E3F2FD {
entity "users" as users {
  * id : integer <<PK>>
  --
  * username : varchar(100) <<UK>>
  * email : varchar(255) <<UK>>
  * password_hash : varchar(255)
  * role : varchar(20)
  * is_verified : boolean
  * bio : varchar(1000)
    device_token : varchar(512)
    verification_token_hash : varchar(64) <<UK>>
    verification_token_expires_at : timestamptz
    verification_email_sent_at : timestamptz
  * interest_topics : jsonb <color:#6D4C41><size:11>{default []}</size></color>
  * skill_vector : jsonb <color:#6D4C41><size:11>{default []}</size></color>
    full_name : varchar(150)
  .. restricciones ..
  <size:11><color:#455A64>UK verification_token_hash WHERE NOT NULL</color></size>
}
}

package "Credential Verification" #E8F5E9 {
entity "certificates" as certificates {
  * id : integer <<PK>>
  --
  * owner_id : integer <<ref>>
    holder_name : varchar(255)
    institution_name : varchar(255)
    course_name : varchar(255)
    issue_date : date
    duration_hours : integer
    certificate_number : varchar(255)
    verification_code : varchar(255)
    verification_url : varchar(2048)
    qr_payload : varchar(4096)
  * ocr_text : text
  * file_hash : varchar(64)
  * storage_reference : varchar(512)
  * status : varchar(20)
  * verification_method : varchar(20)
    risk_score : integer
  * created_at : timestamptz
    verified_at : timestamptz
  * holder_name_mismatch : boolean <color:#6D4C41><size:11>{default false}</size></color>
  .. restricciones ..
  <size:11><color:#455A64>UK (owner_id, file_hash)</color></size>
}
}

package "Learning Path Engine" #FFF8E1 {
entity "learning_paths" as learning_paths {
  * id : integer <<PK>>
  --
  * student_id : integer <<ref>>
  * career_goal : jsonb
  * status : varchar(20) <color:#6D4C41><size:11>{Active | Paused | Completed}</size></color>
  * created_at : timestamptz
  * updated_at : timestamptz
  * last_progress_at : timestamptz
  * is_advanced : boolean <color:#6D4C41><size:11>{default false}</size></color>
}
entity "path_nodes" as path_nodes {
  * id : integer <<PK>>
  --
  * skill_tag : varchar(100)
  * node_order : integer
  * status : varchar(20)
  * prerequisites : varchar(1000)
    linked_certificate_id : integer <<ref>>
    assessment_blueprint_id : integer <<ref>>
  * learning_path_id : integer <<FK>>
  * completed_by_certificate : boolean <color:#6D4C41><size:11>{default false}</size></color>
  .. restricciones ..
  <size:11><color:#455A64>UK (learning_path_id, node_order)</color></size>
  <size:11><color:#455A64>UK (learning_path_id, skill_tag)</color></size>
  <size:11><color:#455A64>CHECK completed_by_certificate => status = 'Completed'</color></size>
  <size:11><color:#455A64>    AND linked_certificate_id NOT NULL</color></size>
}
entity "assessment_blueprints" as assessment_blueprints {
  * id : integer <<PK>>
  --
  * path_node_id : integer <<ref>>
  * skill_tag : varchar(100)
  * questions : jsonb
  * generated_at : timestamptz
}
entity "advanced_path_unlocks" as advanced_path_unlocks {
  * id : integer <<PK>>
  --
  * student_id : integer <<ref>>
  * redemption_id : integer <<UK, ref>>
    learning_path_id : integer <<UK, ref>>
  * granted_at : timestamptz
    used_at : timestamptz
  .. restricciones ..
  <size:11><color:#455A64>CHECK learning_path_id and used_at both NULL or both set</color></size>
}
}

package "Assessment & Peer Review" #F3E5F5 {
entity "assessment_attempts" as assessment_attempts {
  * id : integer <<PK>>
  --
  * blueprint_id : integer <<UK, ref>>
  * student_id : integer <<ref>>
  * selected_answers : jsonb
  * score : varchar(10)
  * passed : boolean
  * completed_at : timestamptz
}
entity "verification_cases" as verification_cases {
  * id : integer <<PK>>
  --
  * attempt_id : integer <<UK, ref>>
  * student_id : integer <<ref>>
    verifier_user_id : integer <<ref>>
  * path_node_id : integer <<ref>>
  * skill_tag : varchar(100)
  * status : varchar(20)
    decision : varchar(20)
    rubric_notes : varchar(2000)
    evidence_url : varchar(500)
  * opened_at : timestamptz
    assigned_at : timestamptz
    resolved_at : timestamptz
  * appeal_count : integer <color:#6D4C41><size:11>{default 0}</size></color>
    previous_verifier_user_id : integer <<ref>>
  * case_type : varchar(20) <color:#6D4C41><size:11>{Quiz | MiniProject}</size></color>
    review_due_at : timestamptz
    review_deadline_amount : integer <color:#6D4C41><size:11>{> 0}</size></color>
    review_deadline_unit : varchar(20) <color:#6D4C41><size:11>{Hours | BusinessDays}</size></color>
    deadline_missed_at : timestamptz
  * reassignment_count : integer <color:#6D4C41><size:11>{default 0}</size></color>
  .. restricciones ..
  <size:11><color:#455A64>UK (student_id, path_node_id) WHERE status <> 'Resolved'</color></size>
  <size:11><color:#455A64>CHECK review_deadline_amount and _unit both NULL or both set</color></size>
}
entity "verifier_profiles" as verifier_profiles {
  * id : integer <<PK>>
  --
  * verifier_user_id : integer <<UK, ref>>
  * skill_tags : jsonb
  * available : boolean
  * verified : boolean
  * rating : double precision
  * review_count : integer
  * created_at : timestamptz
}
entity "review_deadline_policies" as review_deadline_policies {
  * plan : varchar(20) <<PK>> <color:#6D4C41><size:11>{Free | Premium}</size></color>
  --
  * amount : integer <color:#6D4C41><size:11>{> 0}</size></color>
  * unit : varchar(20) <color:#6D4C41><size:11>{Hours | BusinessDays}</size></color>
  * updated_by_user_id : integer <<ref>>
  * updated_at : timestamptz
}
}

package "Reputation" #FCE4EC {
entity "student_employability_scores" as student_employability_scores {
  * id : integer <<PK>>
  --
  * student_id : integer <<UK, ref>>
  * verified_skills_count : integer
  * score : integer
  * updated_at : timestamptz
}
entity "verifier_reliabilities" as verifier_reliabilities {
  * id : integer <<PK>>
  --
  * verifier_user_id : integer <<UK, ref>>
  * resolved_cases_count : integer
  * overturned_decisions_count : integer
  * sanctions_count : integer
  * score : integer
  * updated_at : timestamptz
  * missed_deadlines_count : integer <color:#6D4C41><size:11>{default 0}</size></color>
}
}

package "Recognition & Incentives" #E0F7FA {
entity "wallets" as wallets {
  * id : integer <<PK>>
  --
  * wallet_owner_id : integer <<UK, ref>>
  * balance : integer <color:#6D4C41><size:11>{>= 0}</size></color>
}
entity "credit_transactions" as credit_transactions {
  * id : integer <<PK>>
  --
  * wallet_id : integer <<FK>>
  * amount : integer <color:#6D4C41><size:11>{> 0}</size></color>
  * type : varchar(20)
  * description : varchar(200)
    related_case_id : integer <<ref>>
  * created_at : timestamptz
    redemption_item : varchar(30) <color:#6D4C41><size:11>{AdvancedPathUnlock | ContributionCertificate}</size></color>
  .. restricciones ..
  <size:11><color:#455A64>UK (wallet_id, related_case_id) WHERE related_case_id NOT NULL</color></size>
  <size:11><color:#455A64>CHECK redemption_item only when type = 'Redeemed'</color></size>
}
}

package "Subscription & Billing" #EDE7F6 {
entity "subscriptions" as subscriptions {
  * id : integer <<PK>>
  --
  * student_id : integer <<ref>>
  * plan_name : varchar(50)
  * plan_product_id : varchar(100)
  * plan_price : numeric(10,2) <color:#6D4C41><size:11>{>= 0}</size></color>
  * plan_currency : varchar(3)
  * status : varchar(20) <color:#6D4C41><size:11>{Active | Cancelled | Expired}</size></color>
    store_transaction_id : varchar(255)
  * started_at : timestamptz
  * current_period_end : timestamptz
    cancelled_at : timestamptz
    expired_at : timestamptz
  * updated_at : timestamptz
  .. restricciones ..
  <size:11><color:#455A64>UK (student_id) WHERE status <> 'Expired'</color></size>
}
entity "processed_webhook_events" as processed_webhook_events {
  * id : integer <<PK>>
  --
  * event_id : varchar(255) <<UK>>
  * event_type : varchar(50)
    app_user_id : varchar(255)
    environment : varchar(20)
  * processed_at : timestamptz
}
}

package "Moderation & Disputes" #FBE9E7 {
entity "disputes" as disputes {
  * id : integer <<PK>>
  --
  * source_type : varchar(40) <color:#6D4C41><size:11>{CertificateReview | VerifierDecisionAppeal | UserReport}</size></color>
  * source_reference_id : integer <<ref>>
    raised_by_user_id : integer <<ref>>
    respondent_user_id : integer <<ref>>
  * reason : varchar(500)
  * status : varchar(20) <color:#6D4C41><size:11>{Pending | Resolved}</size></color>
    outcome : varchar(20) <color:#6D4C41><size:11>{Upheld | Overturned | Dismissed | Sanctioned}</size></color>
    resolution_notes : varchar(2000)
    assigned_verifier_user_id : integer <<ref>>
  * assigned_to_senior : boolean <color:#6D4C41><size:11>{default false}</size></color>
    assigned_at : timestamptz
  * raised_at : timestamptz
    resolved_at : timestamptz
  .. restricciones ..
  <size:11><color:#455A64>UK (source_reference_id) WHERE source_type = 'CertificateReview'</color></size>
  <size:11><color:#455A64>CHECK assigned_verifier_user_id <> respondent_user_id</color></size>
}
}

learning_paths ||--|{ path_nodes : "learning_path_id\nON DELETE CASCADE"
wallets ||--o{ credit_transactions : "wallet_id\nON DELETE CASCADE"
users ||..o{ certificates : "owner_id"
users ||..o{ learning_paths : "student_id"
certificates |o..o{ path_nodes : "linked_certificate_id"
assessment_blueprints |o..o| path_nodes : "assessment_blueprint_id"
path_nodes ||..o{ assessment_blueprints : "path_node_id"
users ||..o{ advanced_path_unlocks : "student_id"
credit_transactions ||..o| advanced_path_unlocks : "redemption_id"
learning_paths |o..o| advanced_path_unlocks : "learning_path_id"
assessment_blueprints ||..o| assessment_attempts : "blueprint_id"
users ||..o{ assessment_attempts : "student_id"
assessment_attempts ||..o| verification_cases : "attempt_id"
users ||..o{ verification_cases : "student_id"
users |o..o{ verification_cases : "verifier_user_id"
users |o..o{ verification_cases : "previous_verifier_user_id"
path_nodes ||..o{ verification_cases : "path_node_id"
users ||..o| verifier_profiles : "verifier_user_id"
users ||..o{ review_deadline_policies : "updated_by_user_id"
users ||..o| student_employability_scores : "student_id"
users ||..o| verifier_reliabilities : "verifier_user_id"
users ||..o| wallets : "wallet_owner_id"
verification_cases |o..o{ credit_transactions : "related_case_id"
users ||..o{ subscriptions : "student_id"
certificates ||..o| disputes : "source_reference_id\n(CertificateReview)"
users |o..o{ disputes : "raised_by_user_id"
users |o..o{ disputes : "respondent_user_id"
users |o..o{ disputes : "assigned_verifier_user_id"

legend bottom left
  <b>●</b> NOT NULL   <b>PK</b> clave primaria   <b>FK</b> clave foránea   <b>UK</b> única   <b>ref</b> id de otra tabla sin FK
  <b>timestamptz</b> = timestamp with time zone. Entre llaves: valores o regla del CHECK de la columna.
  Línea continua: FOREIGN KEY real.   Línea punteada: referencia por id sin FOREIGN KEY (entre tablas del mismo o de otro Bounded Context).
endlegend

@enduml
