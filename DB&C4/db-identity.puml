@startuml db-identity
!pragma layout smetana
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam linetype ortho
skinparam ArrowColor #546E7A
skinparam class {
  BorderColor #2F5F8A
  AttributeFontColor #1F2933
  AttributeFontSize 11
}
skinparam package {
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
  FontSize 10
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 10
}
hide circle
hide stereotype

title <size:14>Base de datos · Identity & Access</size>
package "Identity & Access" {
entity "<color:#FFFFFF><b>users</b></color>" as users #back:FFFFFF;header:2F5F8A;line:2F5F8A {
  * id : integer <<PK>>
  --
  * username : varchar(100) <<UK>>
  * email : varchar(255) <<UK>>
  * password_hash : varchar(255)
  * role : varchar(20)
  * is_verified : boolean
  * bio : varchar(1000)
    device_token : varchar(512)
    verification_token_hash : varchar(64) <<UK*>>
    verification_token_expires_at : timestamptz
    verification_email_sent_at : timestamptz
  * interest_topics : jsonb
  * skill_vector : jsonb
    full_name : varchar(150)
}
}
legend bottom left
  <b>Notación</b>: <b>●</b> NOT NULL · <b><<PK>></b> clave primaria · <b><<FK>></b> FOREIGN KEY física ·
  <b><<ref>></b> referencia por id sin FOREIGN KEY (otro agregado o Bounded Context) · <b><<UK>></b> único (<b>UK*</b> índice único parcial)
  Línea continua: FOREIGN KEY física · Línea discontinua: referencia lógica por id · Tablas grises: tablas de otro Bounded Context
  Esquema final de las migraciones Flyway V1–V10 (PostgreSQL). varchar = character varying · timestamptz = timestamp with time zone
  <b>Restricciones e índices</b>
  • UNIQUE (email), UNIQUE (username)
  • UNIQUE parcial (verification_token_hash) WHERE verification_token_hash IS NOT NULL
  • Solo se guarda el SHA-256 del token del enlace de verificación (V6)
endlegend

@enduml
