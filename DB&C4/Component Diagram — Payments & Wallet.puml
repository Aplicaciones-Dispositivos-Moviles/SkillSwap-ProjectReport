@startuml RecognitionIncentivesComponent
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(mobileApps, "Apps móviles", "Kotlin / Jetpack Compose y Flutter / Dart", "Confirman la biometría en el dispositivo antes de canjear")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(recognitionBC, "Recognition & Incentives Bounded Context") {
    Component(walletsController, "WalletsController", "Java Class", "Saldo y movimientos de la wallet")
    Component(creditTransactionsController, "CreditTransactionsController", "Java Class", "POST /redeem: canjear un beneficio")
    Component(walletCommandService, "WalletCommandService", "Java Class", "Crea la wallet, acredita y canjea SkillCredits (no se compran ni se transfieren)")
    Component(walletQueryService, "WalletQueryService", "Java Class", "Consultas")
    Component(creditRewards, "CreditRewards", "Domain Service", "40 por miniproyecto / 25 por quiz resuelto")
    Component(redemptionPricing, "RedemptionPricing", "Domain Service", "Ruta avanzada 200 / certificado de contribución 120")
    Component(eventHandlers, "CreateWallet / CreditVerifier EventHandlers", "Java Class", "Reaccionan a UserRegistered y VerificationCaseResolved")
    Component(repositories, "Wallet / CreditTransaction Repositories", "Java Interface", "Interfaces de persistencia")
    Component(eventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Publica tras el commit")
    Component(recognitionFacade, "RecognitionContextFacade", "Java Class", "Canjes de ruta avanzada del usuario")
}

Component_Ext(otherPublishers, "DomainEventPublisher", "Java Class (Shared)", "Bounded Contexts: Identity & Access y Assessment & Peer Review")
Component_Ext(grantUnlockHandler, "GrantAdvancedPathUnlockEventHandler", "Java Class", "Bounded Context: Learning Path Engine")
Component_Ext(learningPathCommandService, "LearningPathCommandService", "Java Class", "Bounded Context: Learning Path Engine")

Rel(mobileApps, walletsController, "Request HTTP", "HTTPS/JSON")
Rel(mobileApps, creditTransactionsController, "Request HTTP", "HTTPS/JSON")
Rel(walletsController, walletQueryService, "Usa")
Rel(creditTransactionsController, walletCommandService, "Usa")

Rel(otherPublishers, eventHandlers, "UserRegistered / VerificationCaseResolved (tras el commit)")
Rel(eventHandlers, walletCommandService, "Crea la wallet en cero / acredita al Verificador asignado")
Rel(walletCommandService, creditRewards, "Monto por tipo de caso")
Rel(walletCommandService, redemptionPricing, "Costo del beneficio")
Rel(walletCommandService, repositories, "Usa")
Rel(walletQueryService, repositories, "Usa")
Rel(repositories, mainDB, "SQL Transaction")

Rel(walletCommandService, eventPublisher, "AdvancedPathUnlockRedeemed")
Rel(eventPublisher, grantUnlockHandler, "Tras el commit: otorga el AdvancedPathUnlock")

Rel(recognitionFacade, repositories, "Usa")
Rel(learningPathCommandService, recognitionFacade, "Pedir canjes de ruta avanzada")

@enduml
