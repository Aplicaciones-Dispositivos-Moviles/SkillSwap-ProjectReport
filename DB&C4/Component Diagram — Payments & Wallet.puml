@startuml RecognitionIncentivesComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "PostgreSQL 16")

Container_Boundary(recognitionBC, "Recognition & Incentives Bounded Context") {
    Component(walletController, "Wallet Controller", "Java Class", "RESTful API Controller")
    Component(creditTransactionController, "CreditTransaction Controller", "Java Class", "RESTful API Controller")
    Component(walletCommandService, "Wallet CommandService", "Java Class", "Lógica de negocio")
    Component(walletQueryService, "Wallet QueryService", "Java Class", "Consultas")
    Component(identityEventHandlers, "Identity EventHandlers", "Java Class", "Reacciona a UserRegistered creando la wallet")
    Component(assessmentEventHandlers, "Assessment EventHandlers", "Java Class", "Reacciona a VerificationCaseResolved acreditando SkillCredits")
    Component(walletRepository, "Wallet Repository", "Java Interface", "Interface persistencia")
    Component(creditTransactionRepository, "CreditTransaction Repository", "Java Interface", "Interface persistencia")
    Component(recognitionContextFacade, "Recognition ContextFacade", "Java Class", "Punto de entrada interno")
}

Component_Ext(identityDomainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Bounded Context: Identity & Access")
Component_Ext(assessmentDomainEventPublisher, "DomainEventPublisher", "Java Class (Shared)", "Bounded Context: Assessment & Peer Review")

Rel(androidApp, walletController, "Request HTTP a Recognition & Incentives")
Rel(flutterApp, walletController, "Request HTTP a Recognition & Incentives")
Rel(androidApp, creditTransactionController, "Request HTTP a Recognition & Incentives")
Rel(flutterApp, creditTransactionController, "Request HTTP a Recognition & Incentives")

Rel(walletController, walletQueryService, "Usa")
Rel(creditTransactionController, walletCommandService, "Usa")

Rel(walletCommandService, walletRepository, "Usa")
Rel(walletCommandService, creditTransactionRepository, "Usa")
Rel(walletQueryService, walletRepository, "Usa")
Rel(walletQueryService, creditTransactionRepository, "Usa")
Rel(walletRepository, mainDB, "SQL Transaction")
Rel(creditTransactionRepository, mainDB, "SQL Transaction")

Rel(identityDomainEventPublisher, identityEventHandlers, "En proceso, tras el commit")
Rel(identityEventHandlers, walletCommandService, "Crea la wallet inicial (balance en cero)")

Rel(assessmentDomainEventPublisher, assessmentEventHandlers, "En proceso, tras el commit")
Rel(assessmentEventHandlers, walletCommandService, "Acredita SkillCredits al Verificador asignado")

Rel(recognitionContextFacade, walletCommandService, "Delega")
Rel(recognitionContextFacade, walletQueryService, "Delega")

@enduml