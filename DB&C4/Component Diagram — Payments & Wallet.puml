@startuml WalletIncentivesComponent
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(androidApp, "Android Native App", "Kotlin / Jetpack Compose")
Container_Ext(flutterApp, "Cross-Platform App", "Flutter / Dart")
ContainerDb_Ext(mainDB, "SkillSwap Database", "MySQL 8")

Container_Boundary(walletBC, "Wallet & Incentives Bounded Context") {
    Component(walletController, "Wallet Controller", "C# Class", "RESTful API Controller")
    Component(creditTransactionController, "CreditTransaction Controller", "C# Class", "RESTful API Controller")
    Component(walletCommandService, "Wallet CommandService", "C# Class", "Lógica de negocio")
    Component(walletQueryService, "Wallet QueryService", "C# Class", "Consultas")
    Component(walletRepository, "Wallet Repository", "C# Interface", "Interface persistencia")
    Component(creditTransactionRepository, "CreditTransaction Repository", "C# Interface", "Interface persistencia")
    Component(walletContextFacade, "Wallet ContextFacade", "C# Class", "Punto de entrada interno")
}

Component_Ext(identityCommandService, "Identity CommandService", "C# Class", "Bounded Context: Identity & Access")
Component_Ext(identityContextFacade, "Identity ContextFacade", "C# Class", "Bounded Context: Identity & Access")
Component_Ext(assessmentCommandService, "Assessment CommandService", "C# Class", "Bounded Context: Assessment & Peer Review")

Rel(androidApp, walletController, "Request HTTP a Wallet & Incentives")
Rel(flutterApp, walletController, "Request HTTP a Wallet & Incentives")
Rel(androidApp, creditTransactionController, "Request HTTP a Wallet & Incentives")
Rel(flutterApp, creditTransactionController, "Request HTTP a Wallet & Incentives")

Rel(walletController, walletQueryService, "Usa")
Rel(creditTransactionController, walletCommandService, "Usa")

Rel(walletCommandService, walletRepository, "Usa")
Rel(walletCommandService, creditTransactionRepository, "Usa")
Rel(walletQueryService, walletRepository, "Usa")
Rel(walletQueryService, creditTransactionRepository, "Usa")
Rel(walletRepository, mainDB, "SQL Transaction")
Rel(creditTransactionRepository, mainDB, "SQL Transaction")

Rel(walletQueryService, identityContextFacade, "Confirmar biometría antes de canjear SkillCredits")

Rel(walletContextFacade, walletCommandService, "Delega")
Rel(walletContextFacade, walletQueryService, "Delega")

Rel(identityCommandService, walletContextFacade, "Solicitar creación de wallet inicial al registrarse")
Rel(assessmentCommandService, walletContextFacade, "Notificar caso aprobado para acreditar SkillCredits")

@enduml