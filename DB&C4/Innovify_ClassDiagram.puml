@startuml SkillSwap_ClassDiagram_Mobile

skinparam classAttributeIconSize 0
skinparam packageStyle folder
left to right direction

package "Shared" {
    abstract class AbstractDomainAggregateRoot {
        +id: Long
        +createdAt: Date
        +updatedAt: Date
    }
}

package "Identity & Access" {
    class User <<Aggregate Root>> {
        +username: Username
        +email: Email
        +passwordHash: PasswordHash
        +role: UserRole
        +verified: Boolean
        +bio: String
        +fullName: String
        +deviceToken: DeviceToken
        +interestTopics: List<String>
        +skillVector: List<String>
        +verificationTokenHash: String
        +verificationTokenExpiresAt: Date
        +verificationEmailSentAt: Date
        +verify(): User
        +issueVerificationToken(tokenHash: String, expiresAt: Date, issuedAt: Date): User
        +canReceiveVerificationEmail(now: Date, cooldown: Duration): Boolean
        +isVerificationTokenExpired(now: Date): Boolean
        +updateBio(bio: String): User
        +updateFullName(fullName: String): User
        +replaceInterestTopics(topics: List<String>): User
        +updateSkillVector(skillTags: List<String>): User
        +registerDeviceToken(token: String): User
        +removeDeviceToken(): User
    }

    class Username <<Value Object>> {
        +value: String
    }

    class Email <<Value Object>> {
        +value: String
    }

    class PasswordHash <<Value Object>> {
        +value: String
    }

    class DeviceToken <<Value Object>> {
        +value: String
    }

    enum UserRole {
        STUDENT
    }

    interface EmailSender <<Port>> {
        +send(message: EmailMessage): void
    }

    interface PushNotificationSender <<Port>> {
        +send(deviceToken: String, notification: PushNotification): PushDeliveryResult
    }

    enum PushDeliveryResult {
        SENT
        INVALID_TOKEN
        FAILED
    }

    class BrevoEmailSenderAdapter
    class LoggingEmailSenderAdapter
    class FirebasePushNotificationAdapter
    class LoggingPushNotificationAdapter

    User --> Username
    User --> Email
    User --> PasswordHash
    User --> DeviceToken
    User --> UserRole
    PushNotificationSender ..> PushDeliveryResult
    BrevoEmailSenderAdapter ..|> EmailSender
    LoggingEmailSenderAdapter ..|> EmailSender
    FirebasePushNotificationAdapter ..|> PushNotificationSender
    LoggingPushNotificationAdapter ..|> PushNotificationSender
}

package "Credential Verification" {
    class Certificate <<Aggregate Root>> {
        +ownerId: Long
        +holderName: String
        +institutionName: String
        +courseName: String
        +issueDate: Date
        +durationHours: Integer
        +certificateNumber: String
        +verificationCode: String
        +verificationUrl: String
        +qrPayload: String
        +ocrText: String
        +fileHash: String
        +storageReference: String
        +status: VerificationStatus
        +verificationMethod: VerificationMethod
        +riskAssessment: RiskAssessment
        +verifiedAt: Date
        +holderNameMismatch: Boolean
        +applyExtractedData(): Certificate
        +hasOcrInconsistencies(today: Date): Boolean
        +flagHolderNameMismatch(): Certificate
        +assessRisk(riskAssessment: RiskAssessment): Certificate
        +resolveDispute(isAuthentic: Boolean): Certificate
    }

    class RiskAssessment <<Value Object>> {
        +score: Integer
        +level(): RiskLevel
    }

    class HolderNameMatcher <<Domain Service>> {
        +matches(certificateHolder: String, registeredName: String): Boolean
        +isComparable(name: String): Boolean
    }

    enum RiskLevel {
        LOW_RISK
        REVIEW
        HIGH_RISK
    }

    enum VerificationStatus {
        PENDING
        UNVERIFIED
        SUSPICIOUS
        VERIFIED
        REJECTED
    }

    enum VerificationMethod {
        OCR_ONLY
        QR
        ISSUER_URL
        OFFICIAL_REGISTRY
        MANUAL
    }

    Certificate --> RiskAssessment
    Certificate --> VerificationStatus
    Certificate --> VerificationMethod
    RiskAssessment --> RiskLevel
    HolderNameMatcher ..> Certificate : compara holderName
}

package "Learning Path Engine" {
    class LearningPath <<Aggregate Root>> {
        +studentId: Long
        +careerGoal: CareerGoal
        +status: PathStatus
        +advanced: Boolean
        +lastProgressAt: Date
        +pause(): LearningPath
        +resume(): LearningPath
        +completeNode(nodeId: Long): LearningPath
        +recognizeCertifiedSkill(skillTag: String, certificateId: Long): Boolean
        +associateCertificate(nodeId: Long, certificateId: Long): LearningPath
        +linkCertificate(nodeId: Long, certificateId: Long): Boolean
        +linkCertificateToSkill(skillTag: String, certificateId: Long): Boolean
        +attachBlueprint(nodeId: Long, blueprintId: Long): LearningPath
        +pendingPrerequisitesOf(nodeId: Long): List<String>
    }

    class PathNode <<Entity>> {
        +skillTag: String
        +order: Integer
        +status: NodeStatus
        +prerequisiteSkillTags: List<String>
        +linkedCertificateId: Long
        +assessmentBlueprintId: Long
        +completedByCertificate: Boolean
        +unlock(): void
        +complete(): void
        +linkCertificate(certificateId: Long): void
        +completeWithCertificate(certificateId: Long): void
        +attachBlueprint(blueprintId: Long): void
    }

    class AdvancedPathUnlock <<Aggregate Root>> {
        +studentId: Long
        +redemptionId: Long
        +learningPathId: Long
        +grantedAt: Date
        +usedAt: Date
        +useFor(learningPathId: Long): AdvancedPathUnlock
        +isAvailable(): Boolean
    }

    class CareerGoal <<Value Object>> {
        +rawText: String
        +mappedSkillTags: List<String>
    }

    class SkillGap <<Value Object>> {
        +verifiedSkillTags: List<String>
        +missingSkillTags: List<String>
    }

    class AssessmentBlueprint <<Aggregate Root>> {
        +pathNodeId: Long
        +skillTag: String
        +generatedAt: Date
    }

    class Question <<Entity>> {
        +questionString: String
        +answers: List<String>
        +correctAnswer: Integer
    }

    interface SkillTaxonomyMatcher <<Port>> {
        +match(text: String): List<String>
    }

    class GeminiSkillTaxonomyMatcher {
        +match(text: String): List<String>
    }

    class KeywordSkillTaxonomyMatcher {
        +match(text: String): List<String>
    }

    interface QuestionGenerationService <<Domain Service>> {
        +generateQuestions(skillTag: String, excludedQuestions: Collection<String>): List<Question>
    }

    class GeminiQuestionGenerator

    class GeminiClient {
        +generateJson(prompt: String): String
    }

    enum PathStatus {
        ACTIVE
        PAUSED
        COMPLETED
    }

    enum NodeStatus {
        LOCKED
        AVAILABLE
        COMPLETED
    }

    LearningPath "1" o-- "0..*" PathNode
    LearningPath --> CareerGoal
    LearningPath --> PathStatus
    PathNode --> NodeStatus
    AssessmentBlueprint "1" o-- "1..*" Question
    GeminiSkillTaxonomyMatcher ..|> SkillTaxonomyMatcher
    KeywordSkillTaxonomyMatcher ..|> SkillTaxonomyMatcher
    GeminiSkillTaxonomyMatcher --> KeywordSkillTaxonomyMatcher : fallback
    GeminiSkillTaxonomyMatcher --> GeminiClient
    GeminiQuestionGenerator ..|> QuestionGenerationService
    GeminiQuestionGenerator --> GeminiClient
}

package "Assessment & Peer Review" {
    class AssessmentAttempt <<Aggregate Root>> {
        +blueprintId: Long
        +studentId: Long
        +selectedAnswers: List<Integer>
        +score: Score
        +passed: Boolean
        +completedAt: Date
        +incorrectQuestionIndexes(correctAnswers: List<Integer>): List<Integer>
    }

    class Score <<Value Object>> {
        +value: Integer
        +total: Integer
    }

    class VerifierProfile <<Aggregate Root>> {
        +verifierUserId: Long
        +skillTags: List<String>
        +available: Boolean
        +verified: Boolean
        +rating: Double
        +reviewCount: Integer
        +canReview(skillTag: String): Boolean
        +addSkill(skillTag: String): Boolean
        +setAvailability(available: Boolean): VerifierProfile
        +incrementReviewCount(): VerifierProfile
        +updateRating(rating: Double): VerifierProfile
        +revoke(): VerifierProfile
    }

    class VerificationCase <<Aggregate Root>> {
        +attemptId: Long
        +studentId: Long
        +verifierUserId: Long
        +pathNodeId: Long
        +skillTag: String
        +caseType: CaseType
        +status: CaseStatus
        +decision: ReviewDecision
        +rubricNotes: String
        +evidenceUrl: String
        +openedAt: Date
        +reviewDueAt: Date
        +reviewDeadlineAmount: Integer
        +reviewDeadlineUnit: String
        +deadlineMissedAt: Date
        +reassignmentCount: Integer
        +assignedAt: Date
        +resolvedAt: Date
        +appealCount: Integer
        +previousVerifierUserId: Long
        +assignVerifier(verifierUserId: Long): VerificationCase
        +attachEvidence(url: String): VerificationCase
        +resolve(decision: ReviewDecision, rubricNotes: String): VerificationCase
        +appeal(): VerificationCase
        +isOverdue(now: Date): Boolean
        +recordMissedDeadline(now: Date): Boolean
        +reassignAfterMissedDeadline(newVerifierUserId: Long, deadline: ReviewDeadline, now: Date): VerificationCase
    }

    class ReviewDeadlinePolicy <<Aggregate Root>> {
        +plan: String
        +amount: Integer
        +unit: String
        +updatedByUserId: Long
        +updatedAt: Date
        +define(deadline: ReviewDeadline, definedByUserId: Long): ReviewDeadlinePolicy
        +{static} isValidFor(plan: String, deadline: ReviewDeadline): Boolean
        +{static} defaultFor(plan: String): ReviewDeadline
    }

    class ReviewDeadline <<Value Object>> {
        +amount: Integer
        +unit: DeadlineUnit
    }

    enum DeadlineUnit {
        HOURS
        BUSINESS_DAYS
    }

    enum CaseType {
        QUIZ
        MINI_PROJECT
    }

    enum CaseStatus {
        PENDING
        ASSIGNED
        RESOLVED
    }

    enum ReviewDecision {
        APPROVED
        REJECTED
    }

    AssessmentAttempt --> Score
    VerificationCase --> CaseType
    VerificationCase --> CaseStatus
    VerificationCase --> ReviewDecision
    VerificationCase ..> ReviewDeadline
    ReviewDeadlinePolicy --> ReviewDeadline
    ReviewDeadline --> DeadlineUnit
}

package "Reputation" {
    class VerifierReliability <<Aggregate Root>> {
        +verifierUserId: Long
        +resolvedCasesCount: Integer
        +overturnedDecisionsCount: Integer
        +sanctionsCount: Integer
        +missedDeadlinesCount: Integer
        +score: ReliabilityScore
        +updatedAt: Date
        +getRank(): VerifierRank
        +isSeniorVerifier(): Boolean
        +recordResolution(): VerifierReliability
        +recordOverturn(): VerifierReliability
        +applySanction(): VerifierReliability
        +recordMissedDeadline(): VerifierReliability
    }

    class StudentEmployabilityScore <<Aggregate Root>> {
        +studentId: Long
        +verifiedSkillsCount: Integer
        +score: EmployabilityScore
        +updatedAt: Date
        +recordSkillVerified(): StudentEmployabilityScore
    }

    class ReliabilityScore <<Value Object>> {
        +value: Integer
    }

    class EmployabilityScore <<Value Object>> {
        +value: Integer
    }

    enum VerifierRank {
        BRONZE
        SILVER
        GOLD
    }

    class SeniorVerifierPolicy <<Domain Service>> {
        +{static} isSenior(resolvedCasesCount: Integer, reliability: ReliabilityScore): Boolean
    }

    VerifierReliability --> ReliabilityScore
    VerifierReliability ..> VerifierRank
    VerifierReliability ..> SeniorVerifierPolicy
    StudentEmployabilityScore --> EmployabilityScore
}

package "Recognition & Incentives" {
    class Wallet <<Aggregate Root>> {
        +walletOwnerId: Long
        +balance: Integer
        +canAfford(amount: Credits): Boolean
        +credit(amount: Credits): Wallet
        +debit(amount: Credits): Wallet
    }

    class CreditTransaction <<Entity>> {
        +walletId: Long
        +amount: Credits
        +type: TransactionType
        +description: String
        +relatedCaseId: Long
        +redemptionItem: RedemptionItem
        +createdAt: Date
    }

    class Credits <<Value Object>> {
        +value: Integer
    }

    enum TransactionType {
        EARNED
        REDEEMED
    }

    enum RedemptionItem {
        ADVANCED_PATH_UNLOCK
        CONTRIBUTION_CERTIFICATE
    }

    Wallet "1" o-- "0..*" CreditTransaction
    CreditTransaction --> Credits
    CreditTransaction --> TransactionType
    CreditTransaction --> RedemptionItem
}

package "Subscription & Billing" {
    class Subscription <<Aggregate Root>> {
        +studentId: Long
        +plan: SubscriptionPlan
        +status: SubscriptionStatus
        +storeTransactionId: String
        +startedAt: Date
        +currentPeriodEnd: Date
        +cancelledAt: Date
        +expiredAt: Date
        +grantsPremiumAt(moment: Date): Boolean
        +renew(newPeriodEnd: Date, storeTransactionId: String): Boolean
        +cancel(): void
        +uncancel(): void
        +expire(): void
    }

    class PurchaseVerification <<Value Object>> {
        +active: Boolean
        +productId: String
        +expiresAt: Date
        +willRenew: Boolean
        +storeTransactionId: String
        +sandbox: Boolean
    }

    interface PaymentGateway <<Domain Service>> {
        +verifyPurchase(studentId: Long, productId: String): PurchaseVerification
        +cancelRenewal(studentId: Long, storeTransactionId: String): void
    }

    class RevenueCatGatewayAdapter
    class SimulatedPaymentGatewayAdapter

    class SubscriptionPlan <<Value Object>> {
        +name: String
        +productId: String
        +price: Money
    }

    class Money <<Value Object>> {
        +amount: Decimal
        +currency: String
    }

    enum SubscriptionStatus {
        ACTIVE
        CANCELLED
        EXPIRED
    }

    Subscription --> SubscriptionPlan
    Subscription --> SubscriptionStatus
    SubscriptionPlan --> Money
    PaymentGateway ..> PurchaseVerification
    RevenueCatGatewayAdapter ..|> PaymentGateway
    SimulatedPaymentGatewayAdapter ..|> PaymentGateway
}

package "Moderation & Disputes" {
    class Dispute <<Aggregate Root>> {
        +sourceType: DisputeSourceType
        +sourceReferenceId: Long
        +raisedByUserId: Long
        +respondentUserId: Long
        +reason: String
        +status: DisputeStatus
        +outcome: DisputeOutcome
        +resolutionNotes: String
        +assignedVerifierUserId: Long
        +assignedToSenior: Boolean
        +assignedAt: Date
        +raisedAt: Date
        +resolvedAt: Date
        +{static} certificateReview(certificateId: Long, ownerId: Long, reasons: List<String>): Dispute
        +assignReviewer(verifierUserId: Long, senior: Boolean): Dispute
        +resolve(outcome: DisputeOutcome, resolutionNotes: String, validator: DisputeResolutionValidator): Dispute
        +isParty(userId: Long): Boolean
        +isAssignedTo(userId: Long): Boolean
        +isPending(): Boolean
        +hasReviewer(): Boolean
    }

    class DisputeReviewerSelector <<Domain Service>> {
        +choose(excludedUserIds: Collection<Long>, candidates: List<ReviewerCandidate>): Optional<ReviewerChoice>
    }

    class DisputeResolutionValidator <<Domain Service>> {
        +canResolve(dispute: Dispute): Boolean
        +isValidOutcome(sourceType: DisputeSourceType, outcome: DisputeOutcome): Boolean
    }

    class ReviewerCandidate <<Value Object>> {
        +userId: Long
        +senior: Boolean
        +workload: Integer
    }

    class ReviewerChoice <<Value Object>> {
        +userId: Long
        +senior: Boolean
    }

    enum DisputeSourceType {
        CERTIFICATE_REVIEW
        VERIFIER_DECISION_APPEAL
        USER_REPORT
    }

    enum DisputeStatus {
        PENDING
        RESOLVED
    }

    enum DisputeOutcome {
        UPHELD
        OVERTURNED
        DISMISSED
        SANCTIONED
    }

    Dispute --> DisputeSourceType
    Dispute --> DisputeStatus
    Dispute --> DisputeOutcome
    Dispute ..> DisputeResolutionValidator
    DisputeReviewerSelector ..> ReviewerCandidate
    DisputeReviewerSelector ..> ReviewerChoice
}

' --- Herencia hacia el Aggregate Root compartido ---
User --|> AbstractDomainAggregateRoot
Certificate --|> AbstractDomainAggregateRoot
LearningPath --|> AbstractDomainAggregateRoot
AdvancedPathUnlock --|> AbstractDomainAggregateRoot
AssessmentBlueprint --|> AbstractDomainAggregateRoot
AssessmentAttempt --|> AbstractDomainAggregateRoot
VerifierProfile --|> AbstractDomainAggregateRoot
VerificationCase --|> AbstractDomainAggregateRoot
ReviewDeadlinePolicy --|> AbstractDomainAggregateRoot
VerifierReliability --|> AbstractDomainAggregateRoot
StudentEmployabilityScore --|> AbstractDomainAggregateRoot
Wallet --|> AbstractDomainAggregateRoot
CreditTransaction --|> AbstractDomainAggregateRoot
Dispute --|> AbstractDomainAggregateRoot
Subscription --|> AbstractDomainAggregateRoot

' --- Enlaces invisibles para forzar layout en 2 filas ---
"Identity & Access" -[hidden]right- "Credential Verification"
"Credential Verification" -[hidden]right- "Learning Path Engine"
"Learning Path Engine" -[hidden]right- "Assessment & Peer Review"

"Reputation" -[hidden]right- "Recognition & Incentives"
"Recognition & Incentives" -[hidden]right- "Subscription & Billing"
"Subscription & Billing" -[hidden]right- "Moderation & Disputes"

"Identity & Access" -[hidden]down- "Reputation"

@enduml
