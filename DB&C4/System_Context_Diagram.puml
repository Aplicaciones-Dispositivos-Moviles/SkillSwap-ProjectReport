@startuml SkillSwapSystemContext
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(student, "Estudiante", "Sube certificados de cursos externos, sigue su ruta de aprendizaje y demuestra sus habilidades con quizzes generados por la plataforma; si reprueba, puede escalar el quiz a un Verificador dentro del cupo de su plan.")
Person(verifier, "Verificador", "Estudiante habilitado como Verificador en cada nodo de habilidad que completó; aprueba o rechaza con rúbrica los casos abiertos por quizzes escalados y gana SkillCredits. El Verificador senior (rango Oro y confiabilidad ≥ 90) revisa los certificados sospechosos.")

System(skillSwapSystem, "SkillSwap Platform", "Plataforma que valida habilidades mediante certificados, rutas de aprendizaje, quizzes generados por IA y revisión de Verificadores.")

System_Ext(emailService, "Brevo (Email API)", "API HTTP de correo transaccional")
System_Ext(pushService, "Firebase Cloud Messaging", "Notificaciones push a la app móvil")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR integrado en la app móvil")
System_Ext(cloudStorage, "Cloudinary", "Almacenamiento de los archivos de certificados")
System_Ext(googlePlayBilling, "Google Play Billing (vía RevenueCat)", "Cobro de la suscripción mensual")
System_Ext(geminiApi, "Gemini API", "IA generativa: interpreta la meta eligiendo solo habilidades del catálogo interno y genera las preguntas de los quizzes")

Rel(student, skillSwapSystem, "Usa (app móvil / landing page)")
Rel(verifier, skillSwapSystem, "Usa (app móvil / landing page)")

Rel(skillSwapSystem, emailService, "Envía el correo de verificación de la cuenta")
Rel(skillSwapSystem, pushService, "Envía notificaciones push (resultado del certificado)")
Rel(skillSwapSystem, mlKitService, "Lee los datos del certificado en el dispositivo (OCR on-device)")
Rel(skillSwapSystem, cloudStorage, "Guarda los archivos de los certificados")
Rel(skillSwapSystem, googlePlayBilling, "Compra, verifica y cancela la suscripción; recibe sus cambios por webhook")
Rel(skillSwapSystem, geminiApi, "Interpreta la meta y genera preguntas")

@enduml
