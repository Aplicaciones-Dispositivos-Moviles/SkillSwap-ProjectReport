@startuml SkillSwapSystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(student, "Estudiante", "Sube certificados de cursos externos, sigue su ruta de aprendizaje y demuestra sus habilidades mediante evaluaciones generadas por la plataforma.")
Person(verifier, "Verificador", "Estudiante que ya completó su propia ruta de certificación; revisa con rúbrica los casos que la IA no puede resolver con suficiente confianza y gana SkillCredits. El Verificador senior resuelve las apelaciones.")

System(skillSwapSystem, "SkillSwap Platform", "Plataforma central que verifica habilidades mediante certificados, evaluaciones generadas por IA y revisión de pares.")

System_Ext(emailService, "Email Api", "Integración con correos institucionales")
System_Ext(mlKitService, "ML Kit (Firebase)", "SDK on-device de OCR/Entity Extraction para procesar certificados")
System_Ext(cloudStorage, "Cloudinary", "Cloud Storage para imágenes de certificados")
System_Ext(googlePlayBilling, "Google Play Billing (vía RevenueCat)", "Procesamiento de la suscripción mensual")

Rel(student, skillSwapSystem, "Usa (app móvil / landing page)")
Rel(verifier, skillSwapSystem, "Usa (app móvil / landing page)")

Rel(skillSwapSystem, emailService, "Envía correos de validación y notificaciones")
Rel(skillSwapSystem, mlKitService, "Extrae datos del certificado (OCR on-device)")
Rel(skillSwapSystem, cloudStorage, "Guarda las imágenes de los certificados")
Rel(skillSwapSystem, googlePlayBilling, "Verifica y procesa la suscripción")

@enduml